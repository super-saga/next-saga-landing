# Slack Incoming Webhook for waitlist leads (server-side only)
SLACK_WEBHOOK_URL=

# Sobi AI agent endpoint (server-side only, never exposed to the client).
# When SOBI_AGENT_URL is unset, /api/sobi/chat runs in STUB mode and streams
# a canned Bahasa Indonesia demo reply via SSE.
# When set, requests are proxied to the upstream agent with an optional Bearer token.
# SOBI_AGENT_URL=
# SOBI_AGENT_KEY=

# Set to "true" to present UMKM as a live feature
# PUBLIC_UMKM_LIVE=

# Ghost Content API for the blog (server-side). Until these are set, the blog
# falls back to a demo Ghost instance.
GHOST_API_URL=https://saga.co.id/blog
GHOST_CONTENT_API_KEY=
# Public site root that serves the Ghost members portal (/members/api/...).
# Used by /api/subscribe for newsletter signup. Defaults to GHOST_API_URL.
GHOST_SITE_URL=https://saga.co.id/blog

# Secret for signing Sobi chat session tokens (lead-gate). REQUIRED in prod.
SOBI_SESSION_SECRET=

# Set PUBLIC_SOBI_AI_LIVE="true" when the Sobi AI agent is ready. Default (off):
# the chat launcher is a lead hook only (form -> Slack -> "coming soon" thank-you).
PUBLIC_SOBI_AI_LIVE=

# Google AdSense (blog only). Set after approval; empty = no ads.
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_SLOT_ARTICLE=
PUBLIC_ADSENSE_SLOT_BLOG=
