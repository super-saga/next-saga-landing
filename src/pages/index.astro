---
import Base from '../layouts/Base.astro';
import Nav from '../components/sections/Nav.astro';
import Hero from '../components/sections/Hero.astro';
import PaymentStrip from '../components/sections/PaymentStrip.astro';
import DualPath from '../components/sections/DualPath.astro';
import BandPengurus from '../components/sections/BandPengurus.astro';
import BandWarga from '../components/sections/BandWarga.astro';
import Umkm from '../components/sections/Umkm.astro';
import Roadmap from '../components/sections/Roadmap.astro';
import Trust from '../components/sections/Trust.astro';
import CaraKerja from '../components/sections/CaraKerja.astro';
import Testimoni from '../components/sections/Testimoni.astro';
import Harga from '../components/sections/Harga.astro';
import BlogTeaser from '../components/sections/BlogTeaser.astro';
import Faq from '../components/sections/Faq.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import Footer from '../components/sections/Footer.astro';
---

<Base
  title="Sahabat Warga, kelola lingkungan lebih mudah"
  description="Satu aplikasi untuk iuran, data warga, komunikasi, dan pembayaran lingkungan."
  playerCard={true}
>
  <Nav />
  <main>
    <Hero />
    <PaymentStrip />
    <DualPath />
    <BandPengurus />
    <BandWarga />
    <Umkm />
    <Roadmap />
    <Trust />
    <CaraKerja />
    <Testimoni />
    <Harga />
    <BlogTeaser />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
</Base>
