---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/sections/Nav.astro';
import Footer from '../../components/sections/Footer.astro';
import PostCard from '../../components/blog/PostCard.astro';
import Sobi from '../../components/sobi/Sobi.astro';
import AdSlot from '../../components/blog/AdSlot.astro';
import { getSinglePost, getPosts, formatTanggal, readingTime, postUrl, tagUrl } from '../../lib/ghost';
import { ADSENSE_SLOT_ARTICLE } from '../../config';

const { slug } = Astro.params;
const post = slug ? await getSinglePost(slug) : null;

if (!post) {
  return Astro.redirect('/blog');
}

const date = formatTanggal(post.published_at);
const minsRead = readingTime(post);
const author = post.authors?.[0];
const tags = post.tags ?? [];
const categoryName = tags[0]?.name ?? '';
const categorySlug = tags[0]?.slug ?? '';

// Canonical mirrors Ghost's trailing-slash pattern: /blog/<slug>/
const canonical = new URL(postUrl(post.slug), Astro.site ?? 'https://saga.co.id').toString();

// Encode share data
const pageTitle = post.title ?? '';
const shareUrl = canonical;
const waShareUrl = `https://wa.me/?text=${encodeURIComponent(pageTitle + ' ' + shareUrl)}`;
const emailShareUrl = `mailto:?subject=${encodeURIComponent(pageTitle)}&body=${encodeURIComponent(shareUrl)}`;

// A few related posts (exclude the current one).
const related = (await getPosts('all')).filter((p) => p.slug !== post.slug).slice(0, 3);

const metaDesc = post.excerpt || post.meta_description || `Artikel Sahabat Warga: ${post.title}`;

// Article structured data for SEO.
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: metaDesc,
  image: post.feature_image ? [post.feature_image] : undefined,
  datePublished: post.published_at ?? undefined,
  dateModified: post.updated_at ?? post.published_at ?? undefined,
  author: author?.name ? { '@type': 'Person', name: author.name } : undefined,
  publisher: {
    '@type': 'Organization',
    name: 'Sahabat Warga',
    logo: { '@type': 'ImageObject', url: new URL('/brand/logo.png', Astro.site ?? 'https://saga.co.id').toString() },
  },
  mainEntityOfPage: canonical,
};
---

<Base title={`${post.title} - Sahabat Warga`} description={metaDesc} canonical={canonical} jsonLdExtra={articleJsonLd}>
  <Nav />

  <main class="bg-bg">

    <!-- ========== ARTICLE HEADER ========== -->
    <div class="bg-white pb-0">
      <div class="px-4 sm:px-8 lg:px-[120px] pt-10 lg:pt-[40px] flex flex-col gap-12 items-center">

        <!-- Breadcrumb -->
        <nav aria-label="Breadcrumb" class="w-full flex items-center gap-2 flex-wrap">
          <a href="/blog/" class="text-[14px] font-semibold text-[#6B7672] no-underline hover:text-text-primary whitespace-nowrap">Blog</a>
          <svg viewBox="0 0 14 14" class="w-4 h-4 shrink-0" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M7.75537 7l-2.47803-2.47803q-0.08203-0.08203-0.08886-0.19824-0.00342-0.11963 0.08886-0.21191 0.09229-0.0957 0.20508-0.09571 0.11279 0 0.2085 0.09571l2.56006 2.56005q0.0752 0.0752 0.10595 0.15381 0.03076 0.07861 0.03077 0.17432 0 0.0957-0.03077 0.17432-0.03076 0.07861-0.10595 0.1538l-2.56006 2.56006q-0.08203 0.08203-0.20166 0.08887-0.11963 0.00684-0.21192-0.08887-0.09229-0.09229-0.09228-0.20507 0-0.11279 0.09228-0.20508l2.47803-2.47803z" fill="#98A29E"/>
          </svg>
          {categoryName && (
            <>
              <a href={tagUrl(categorySlug)} class="text-[14px] font-semibold text-[#6B7672] no-underline hover:text-text-primary whitespace-nowrap">{categoryName}</a>
              <svg viewBox="0 0 14 14" class="w-4 h-4 shrink-0" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M7.75537 7l-2.47803-2.47803q-0.08203-0.08203-0.08886-0.19824-0.00342-0.11963 0.08886-0.21191 0.09229-0.0957 0.20508-0.09571 0.11279 0 0.2085 0.09571l2.56006 2.56005q0.0752 0.0752 0.10595 0.15381 0.03076 0.07861 0.03077 0.17432 0 0.0957-0.03077 0.17432-0.03076 0.07861-0.10595 0.1538l-2.56006 2.56006q-0.08203 0.08203-0.20166 0.08887-0.11963 0.00684-0.21192-0.08887-0.09229-0.09229-0.09228-0.20507 0-0.11279 0.09228-0.20508l2.47803-2.47803z" fill="#98A29E"/>
              </svg>
            </>
          )}
          <span class="text-[14px] font-semibold text-[#0F1A17] line-clamp-1">{post.title}</span>
        </nav>

        <!-- Title column: category chip + title + excerpt + author row -->
        <div class="w-full lg:w-[840px] flex flex-col gap-6 items-center">

          <!-- Category chip -->
          {categoryName && (
            <div class="flex items-center px-[14px] py-[6px] bg-[#C9F5E4] rounded-full">
              <span class="text-[12px] font-bold tracking-[1px] text-[#06372A] uppercase whitespace-nowrap">{categoryName}</span>
            </div>
          )}

          <!-- Title -->
          <h1 class="font-sans text-[36px] lg:text-[56px] font-extrabold leading-[1.1] lg:leading-[62px] tracking-[-1.6px] text-[#0F1A17] text-center w-full">
            {post.title}
          </h1>

          <!-- Excerpt -->
          {post.excerpt && (
            <p class="font-sans text-[17px] lg:text-[19px] leading-[28px] lg:leading-[30px] text-[#6B7672] font-normal text-center w-full lg:w-[720px]">
              {post.excerpt}
            </p>
          )}

          <!-- Author row -->
          {author && (
            <div class="flex items-center gap-3 pt-2">
              {author.profile_image ? (
                <img
                  src={author.profile_image}
                  alt={author.name ?? 'Penulis'}
                  class="w-11 h-11 rounded-full object-cover shrink-0"
                  loading="lazy"
                />
              ) : (
                <div class="flex w-11 h-11 items-center justify-center rounded-full bg-mint-50 font-sans text-sm font-bold text-text-brand shrink-0">
                  {author.name?.charAt(0) ?? 'S'}
                </div>
              )}
              <div class="flex flex-col gap-0.5">
                <span class="font-sans text-[15px] font-bold text-[#0F1A17] whitespace-nowrap">{author.name}</span>
                <span class="font-sans text-[13px] text-[#6B7672] whitespace-nowrap">
                  {[date, minsRead].filter(Boolean).join(' · ')}
                </span>
              </div>
            </div>
          )}
        </div>

        <!-- Hero image -->
        {post.feature_image && (
          <div class="w-full">
            <img
              src={post.feature_image}
              alt={post.title}
              class="w-full h-[280px] sm:h-[400px] lg:h-[560px] object-cover rounded-[20px] lg:rounded-[32px]"
              loading="eager"
              decoding="async"
            />
          </div>
        )}
      </div>
    </div>

    <!-- ========== ARTICLE BODY: two-column layout ========== -->
    <div class="px-4 sm:px-8 lg:px-[120px] py-[48px] lg:py-[72px] pb-[64px] lg:pb-[96px] flex flex-col lg:flex-row gap-10 lg:gap-[80px] justify-center items-start">

      <!-- SIDEBAR -->
      <aside class="w-full lg:w-[240px] shrink-0 flex flex-col gap-8 lg:sticky lg:top-8">

        <!-- TOC -->
        <div id="toc-block" class="hidden flex-col gap-1">
          <p class="text-[12px] font-bold tracking-[1px] text-[#98A29E] uppercase whitespace-nowrap mb-1">DI ARTIKEL INI</p>
          <nav id="toc-list" aria-label="Daftar isi" class="flex flex-col gap-0"></nav>
        </div>

        <!-- Share -->
        <div class="flex flex-col gap-3">
          <p class="text-[12px] font-bold tracking-[1px] text-[#98A29E] uppercase whitespace-nowrap">BAGIKAN</p>
          <div class="flex items-center gap-2">

            <!-- WhatsApp -->
            <a
              href={waShareUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Bagikan ke WhatsApp"
              class="w-10 h-10 shrink-0 flex items-center justify-center bg-white rounded-full outline outline-1 outline-[#E3E7E5] -outline-offset-[0.5px] hover:outline-[#C9F5E4] transition-all"
            >
              <!-- chat icon (Material Symbols Rounded) -->
              <svg viewBox="0 0 14 14" class="w-[18px] h-[18px]" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M3.54443 9.91553l-0.99463 0.99463q-0.21875 0.22217-0.50927 0.10254-0.29053-0.11963-0.29053-0.43409l0-7.88525q0-0.40332 0.27002-0.67334 0.27002-0.27002 0.67334-0.27002l8.61328 0q0.40332 0 0.67334 0.27002 0.27002 0.27002 0.27002 0.67334l0 6.28223q0 0.3999-0.27002 0.66992-0.27002 0.27002-0.67334 0.27002l-7.76221 0z m-0.24951-0.58106l8.01172 0q0.13672 0 0.24609-0.11279 0.11279-0.11279 0.1128-0.24609l0-6.28223q0-0.13672-0.1128-0.24609-0.10938-0.11279-0.24609-0.1128l-8.61328 0q-0.13672 0-0.24951 0.1128-0.10938 0.10938-0.10938 0.24609l0 7.59814 0.96045-0.95703z m-0.96045 0l0-6.64111q0-0.13672 0-0.24609 0-0.11279 0-0.1128 0 0 0 0.1128 0 0.10938 0 0.24609l0 6.28223q0 0.1333 0 0.24609 0 0.11279 0 0.11279z m1.75-1.45947l3.5 0q0.12305 0 0.20508-0.08203 0.08545-0.08545 0.08545-0.2085 0-0.12646-0.08545-0.20849-0.08203-0.08545-0.20508-0.08545l-3.5 0q-0.12646 0-0.21191 0.08545-0.08203 0.08203-0.08203 0.20849 0 0.12305 0.08203 0.2085 0.08545 0.08203 0.21191 0.08203z m0-1.75l5.83106 0q0.12646 0 0.20849-0.08203 0.08545-0.08545 0.08545-0.2085 0-0.12646-0.08545-0.20849-0.08203-0.08545-0.20849-0.08545l-5.83106 0q-0.12646 0-0.21191 0.08545-0.08203 0.08203-0.08203 0.20849 0 0.12305 0.08203 0.2085 0.08545 0.08203 0.21191 0.08203z m0-1.75l5.83106 0q0.12646 0 0.20849-0.08203 0.08545-0.08545 0.08545-0.2085 0-0.12646-0.08545-0.20849-0.08203-0.08545-0.20849-0.08545l-5.83106 0q-0.12646 0-0.21191 0.08545-0.08203 0.08203-0.08203 0.20849 0 0.12305 0.08203 0.2085 0.08545 0.08203 0.21191 0.08203z" fill="#2A3733"/>
              </svg>
            </a>

            <!-- Salin tautan -->
            <button
              id="copy-link-btn"
              aria-label="Salin tautan artikel"
              data-url={shareUrl}
              class="relative w-10 h-10 shrink-0 flex items-center justify-center bg-white rounded-full outline outline-1 outline-[#E3E7E5] -outline-offset-[0.5px] hover:outline-[#C9F5E4] transition-all cursor-pointer"
            >
              <!-- link icon -->
              <svg viewBox="0 0 14 14" class="w-[18px] h-[18px]" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M4.12891 9.37891q-0.98779 0-1.68506-0.69385-0.69385-0.69727-0.69385-1.68506 0-0.98438 0.69385-1.68164 0.69727-0.69727 1.68506-0.69727l1.7705 0q0.12646 0 0.2085 0.08545 0.08545 0.08203 0.08545 0.2085 0 0.12305-0.08545 0.2085-0.08203 0.08203-0.2085 0.08203l-1.77392 0q-0.73828 0-1.26465 0.52636-0.52637 0.52637-0.52637 1.26807 0 0.7417 0.52637 1.26807 0.52637 0.52637 1.26465 0.52636l1.77392 0q0.12646 0 0.2085 0.08545 0.08545 0.08203 0.08545 0.2085 0 0.12305-0.08545 0.2085-0.08203 0.08203-0.2085 0.08203l-1.7705 0z m1.12109-2.08838q-0.12305 0-0.2085-0.08203-0.08203-0.08545-0.08203-0.2085 0-0.12305 0.08203-0.20508 0.08545-0.08545 0.2085-0.08545l3.5 0q0.12305 0 0.20508 0.08545 0.08545 0.08203 0.08545 0.20508 0 0.12305-0.08545 0.2085-0.08203 0.08203-0.20508 0.08203l-3.5 0z m2.85059 2.08838q-0.12646 0-0.21192-0.08203-0.08203-0.08545-0.08203-0.21192 0-0.12305 0.08203-0.20508 0.08545-0.08545 0.21192-0.08545l1.77392 0q0.73828 0 1.26465-0.52636 0.52637-0.52637 0.52637-1.26807 0-0.7417-0.52637-1.26807-0.52637-0.52637-1.26465-0.52636l-1.77392 0q-0.12646 0-0.21192-0.08203-0.08203-0.08545-0.08203-0.21192 0-0.12305 0.08203-0.20508 0.08545-0.08545 0.21192-0.08545l1.7705 0q0.98779 0 1.68164 0.69727 0.69727 0.69385 0.69727 1.68164 0 0.98438-0.69727 1.68164-0.69385 0.69727-1.68164 0.69727l-1.7705 0z" fill="#2A3733"/>
              </svg>
              <!-- Tersalin tooltip -->
              <span id="copy-link-toast" class="pointer-events-none absolute -top-8 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-md bg-[#0F1A17] px-2 py-1 text-[11px] font-semibold text-white opacity-0 transition-opacity duration-200">tersalin</span>
            </button>

            <!-- Email -->
            <a
              href={emailShareUrl}
              aria-label="Bagikan lewat Email"
              class="w-10 h-10 shrink-0 flex items-center justify-center bg-white rounded-full outline outline-1 outline-[#E3E7E5] -outline-offset-[0.5px] hover:outline-[#C9F5E4] transition-all"
            >
              <!-- mail icon -->
              <svg viewBox="0 0 14 14" class="w-[18px] h-[18px]" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M2.69336 11.08447q-0.40332 0-0.67334-0.27002-0.27002-0.27002-0.27002-0.67334l0-6.28222q0-0.40332 0.27002-0.67334 0.27002-0.27002 0.67334-0.27002l8.61328 0q0.40332 0 0.67334 0.27002 0.27002 0.27002 0.27002 0.67334l0 6.28222q0 0.40332-0.27002 0.67334-0.27002 0.27002-0.67334 0.27002l-8.61328 0z m8.97217-7.06836l-4.40576 2.88477q-0.06152 0.03076-0.12647 0.05469-0.06152 0.02051-0.1333 0.0205-0.07178 0-0.13672-0.0205-0.06152-0.02393-0.12305-0.05469l-4.40576-2.88477 0 6.125q0 0.15723 0.09912 0.25977 0.10254 0.09912 0.25977 0.09912l8.61328 0q0.15723 0 0.25635-0.09912 0.10254-0.10254 0.10254-0.25977l0-6.125z m-4.66553 2.39942l4.48779-2.91553-8.97558 0 4.48779 2.91553z m-4.66553-2.39942l0 0.12305q0-0.05127 0-0.13672 0-0.08887 0-0.17431 0-0.11279 0-0.16065 0-0.05127 0 0.01709l0-0.18457 0 0.18457q0-0.06836 0-0.02734 0 0.04102 0 0.16064 0 0.08887 0 0.18115 0 0.09229 0 0.14014l0-0.12305 0 6.125q0 0.15723 0 0.25977 0 0.09912 0 0.09912 0 0 0-0.09912 0-0.10254 0-0.25977l0-6.125z" fill="#2A3733"/>
              </svg>
            </a>
          </div>
        </div>
      </aside>

      <!-- ARTICLE CONTENT COLUMN -->
      <div class="min-w-0 w-full lg:w-[760px] lg:max-w-[760px] shrink-0 flex flex-col gap-6">

        <!-- Tips Sobi callout (before prose; position matches ref placement inside article flow) -->
        <div class="w-full flex items-start gap-4 px-4 py-5 lg:px-[24px] lg:py-[20px] bg-[#EEFBF5] outline outline-1 outline-[#C9F5E4] -outline-offset-[0.5px] rounded-[20px]">
          <div class="shrink-0">
            <Sobi size={56} />
          </div>
          <div class="flex flex-col gap-1 pt-1">
            <p class="font-sans text-[15px] font-bold text-[#08745A] whitespace-nowrap">Tips dari Sobi</p>
            <p class="font-sans text-[16px] leading-[26px] text-[#2A3733]">
              Baca artikel ini sampai selesai untuk mendapatkan panduan lengkap langkah demi langkah.
            </p>
          </div>
        </div>

        <!-- Ghost article HTML -->
        <div class="prose" set:html={post.html} />

        <!-- In-article ad (renders only when AdSense is configured) -->
        <AdSlot slot={ADSENSE_SLOT_ARTICLE} />

        <!-- CTA Card: "Siap beralih ke iuran digital?" -->
        <div class="w-full flex flex-col sm:flex-row items-start sm:items-center gap-6 px-8 py-7 bg-[#06372A] rounded-[24px]">
          <div class="flex flex-col gap-1.5 flex-1">
            <p class="font-sans text-[22px] font-extrabold tracking-[-0.4px] text-white">Siap beralih ke iuran digital?</p>
            <p class="font-sans text-[15px] leading-[23px] text-[#C9F5E4]">Buat komunitas gratis dan kirim tagihan pertama dalam hitungan menit.</p>
          </div>
          <a
            href="#mulai"
            data-open="waitlist"
            class="shrink-0 flex items-center gap-1.5 px-[22px] h-12 bg-primary rounded-full font-sans text-[15px] font-bold text-white no-underline whitespace-nowrap hover:opacity-90 transition-opacity"
          >
            Buat Komunitas
            <svg viewBox="0 0 14 14" class="w-[18px] h-[18px]" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M9.96338 7.29053l-6.75391 0q-0.12646 0-0.21191-0.08203-0.08203-0.08545-0.08203-0.2085 0-0.12305 0.08203-0.20508 0.08545-0.08545 0.21191-0.08545l6.75391 0-3.17188-3.17187q-0.08545-0.08545-0.09228-0.20166-0.00342-0.11621 0.0957-0.21192 0.0957-0.0957 0.20508-0.0957 0.10938-0.00342 0.20508 0.0957l3.54785 3.54785q0.0752 0.0752 0.10596 0.15381 0.03418 0.07861 0.03418 0.17432 0 0.0957-0.03418 0.17432-0.03076 0.07861-0.10596 0.1538l-3.54785 3.54786q-0.08203 0.08203-0.19824 0.08886-0.11621 0.00684-0.21192-0.08886-0.09912-0.0957-0.09912-0.20508 0-0.11279 0.09912-0.2085l3.16846-3.17187z" fill="#FFFFFF"/>
            </svg>
          </a>
        </div>

        <!-- Tags row -->
        {tags.length > 0 && (
          <div class="flex flex-wrap gap-2 border-t border-[#E3E7E5] pt-6 mt-2">
            {tags.map((t) => (
              <a
                href={tagUrl(t.slug)}
                class="flex items-center px-[14px] py-[6px] bg-white outline outline-1 outline-[#E3E7E5] -outline-offset-[0.5px] rounded-full font-sans text-[13px] font-semibold text-[#2A3733] no-underline hover:outline-[#C9F5E4] transition-all whitespace-nowrap"
              >
                #{t.name}
              </a>
            ))}
          </div>
        )}

        <!-- Author bio block (only when author has bio) -->
        {author?.bio && (
          <div class="w-full flex items-center gap-5 p-7 bg-white rounded-[24px]">
            {author.profile_image ? (
              <img
                src={author.profile_image}
                alt={author.name ?? 'Penulis'}
                class="w-[72px] h-[72px] shrink-0 rounded-full object-cover"
                loading="lazy"
              />
            ) : (
              <div class="flex w-[72px] h-[72px] shrink-0 items-center justify-center rounded-full bg-mint-50 font-sans text-xl font-bold text-text-brand">
                {author.name?.charAt(0) ?? 'S'}
              </div>
            )}
            <div class="flex flex-col gap-1.5 flex-1 min-w-0">
              <p class="font-sans text-[11px] font-bold tracking-[1px] text-[#98A29E] uppercase whitespace-nowrap">DITULIS OLEH</p>
              <p class="font-sans text-[18px] font-bold text-[#0F1A17] whitespace-nowrap">{author.name}</p>
              <p class="font-sans text-[14px] leading-[22px] text-[#6B7672]">{author.bio}</p>
            </div>
          </div>
        )}
      </div>
    </div>

    <!-- ========== RELATED ARTICLES ========== -->
    {related.length > 0 && (
      <section class="bg-white border-t border-[#E3E7E5]">
        <div class="px-4 sm:px-8 lg:px-[120px] py-[56px] lg:py-[88px] pb-[72px] lg:pb-[112px] flex flex-col gap-10">
          <!-- Header -->
          <div class="flex items-end justify-between w-full">
            <h2 class="font-sans text-[28px] lg:text-[32px] font-extrabold tracking-[-0.8px] text-[#0F1A17] whitespace-nowrap">Baca juga</h2>
            <a href="/blog/" class="flex items-center gap-1.5 font-sans text-[15px] font-bold text-[#08745A] no-underline hover:opacity-80 transition-opacity whitespace-nowrap">
              Semua artikel
              <svg viewBox="0 0 14 14" class="w-[18px] h-[18px]" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M9.96338 7.29053l-6.75391 0q-0.12646 0-0.21191-0.08203-0.08203-0.08545-0.08203-0.2085 0-0.12305 0.08203-0.20508 0.08545-0.08545 0.21191-0.08545l6.75391 0-3.17188-3.17187q-0.08545-0.08545-0.09228-0.20166-0.00342-0.11621 0.0957-0.21192 0.0957-0.0957 0.20508-0.0957 0.10938-0.00342 0.20508 0.0957l3.54785 3.54785q0.0752 0.0752 0.10596 0.15381 0.03418 0.07861 0.03418 0.17432 0 0.0957-0.03418 0.17432-0.03076 0.07861-0.10596 0.1538l-3.54785 3.54786q-0.08203 0.08203-0.19824 0.08886-0.11621 0.00684-0.21192-0.08886-0.09912-0.0957-0.09912-0.20508 0-0.11279 0.09912-0.2085l3.16846-3.17187z" fill="#08745A"/>
              </svg>
