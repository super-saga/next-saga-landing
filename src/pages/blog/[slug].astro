<!-- ========== CLIENT SCRIPTS ========== -->

<script>
  // TOC: inject IDs into h2/h3 headings in .prose, build TOC list, show block if headings found
  (function buildTOC() {
    const prose = document.querySelector('.prose');
    const tocBlock = document.getElementById('toc-block');
    const tocList = document.getElementById('toc-list');
    if (!prose || !tocBlock || !tocList) return;

    const headings = Array.from(prose.querySelectorAll('h2, h3'));
    if (headings.length === 0) return;

    headings.forEach((el, i) => {
      const id = el.id || `toc-heading-${i}`;
      el.id = id;
      const a = document.createElement('a');
      a.href = `#${id}`;
      a.textContent = el.textContent ?? '';

      // wrapper item
      const item = document.createElement('div');
      item.className = 'toc-item flex items-start border-l border-[#E3E7E5] pl-[14px] py-[10px] -ml-[0.5px]';
      a.className = 'font-sans text-[14px] leading-[20px] font-medium text-[#6B7672] no-underline hover:text-[#0F1A17] transition-colors flex-1';
      item.appendChild(a);
      tocList.appendChild(item);
    });

    tocBlock.classList.remove('hidden');
    tocBlock.classList.add('flex');

    // Highlight active heading on scroll
    const allItems = Array.from(tocList.querySelectorAll('.toc-item a'));
    const allHeadings = headings as HTMLElement[];

    function setActive(idx: number) {
      allItems.forEach((a, i) => {
        const item = a.parentElement!;
        if (i === idx) {
          item.classList.replace('border-[#E3E7E5]', 'border-[#0E9F76]');
          item.classList.replace('-ml-[0.5px]', '-ml-[1.5px]');
          item.style.borderLeftWidth = '3px';
          a.classList.replace('font-medium', 'font-bold');
          a.classList.replace('text-[#6B7672]', 'text-[#0F1A17]');
        } else {
          item.style.borderLeftWidth = '1px';
          item.classList.replace('border-[#0E9F76]', 'border-[#E3E7E5]');
          item.classList.replace('-ml-[1.5px]', '-ml-[0.5px]');
          a.classList.replace('font-bold', 'font-medium');
          a.classList.replace('text-[#0F1A17]', 'text-[#6B7672]');
        }
      });
    }

    if (allHeadings.length > 0) setActive(0);

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting);
        if (visible.length === 0) return;
        const first = visible[0].target as HTMLElement;
        const idx = allHeadings.indexOf(first);
        if (idx >= 0) setActive(idx);
      },
      { rootMargin: '-10% 0px -70% 0px', threshold: 0 }
    );

    allHeadings.forEach((h) => observer.observe(h));
  })();
</script>

<script>
  // Copy link button
  const btn = document.getElementById('copy-link-btn') as HTMLButtonElement | null;
  const toast = document.getElementById('copy-link-toast') as HTMLElement | null;
  if (btn && toast) {
    btn.addEventListener('click', async () => {
      const url = btn.dataset.url ?? window.location.href;
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        // fallback
        const ta = document.createElement('textarea');
        ta.value = url;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      toast.style.opacity = '1';
      setTimeout(() => { toast.style.opacity = '0'; }, 1800);
    });
  }
</script>
