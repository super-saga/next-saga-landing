---

<section id="untuk-pengurus" class="w-full bg-white">
  <div class="w-full flex flex-col gap-[56px] py-[112px] px-[120px] lg:py-[112px] lg:px-[120px] md:py-16 md:px-10 px-4 py-12">

    <!-- Header -->
    <Reveal>
      <div class="w-full max-w-[760px] flex flex-col gap-[16px]">
        <p class="text-[13px] leading-normal text-[#08745A] font-bold tracking-[1.2px] uppercase">
          Untuk Pengurus
        </p>
        <h2 class="text-[40px] leading-[48px] text-[#0F1A17] font-bold tracking-[-0.8px] lg:text-[40px] md:text-[32px] text-[28px]">
          {pengurus.heading}
        </h2>
        <p class="text-[18px] leading-[29px] text-[#6B7672] font-normal lg:text-[18px] md:text-[16px] text-[16px]">
          Dari tagihan sampai gerbang depan, semua yang biasanya tersebar di buku kas, grup WA, dan pos satpam kini ada di satu dashboard.
        </p>
      </div>
    </Reveal>

    <!-- Flagship + Supporting List -->
    <div class="w-full flex flex-col lg:flex-row gap-[64px] items-start">

      <!-- Flagship Card: Iuran Digital & Laporan Transparan -->
      <Reveal delay={60}>
        <article
          class="w-full lg:w-[680px] shrink-0 flex flex-col gap-[36px] p-[48px] bg-[#EEFBF5] rounded-[24px] u-hover-lift"
          aria-labelledby="pengurus-flagship-title"
        >
          <!-- Icon + Text -->
          <div class="flex flex-col gap-[20px]">
            <!-- Icon Tile -->
            <div class="w-[56px] h-[56px] shrink-0 flex items-center justify-center bg-[#0E9F76] rounded-[16px] u-icon-pop">
              <Fragment set:html={walletSvg} />
            </div>

            <h3
              id="pengurus-flagship-title"
              class="text-[28px] leading-[35px] text-[#0F1A17] font-bold tracking-[-0.4px] lg:text-[28px] md:text-[22px] text-[20px]"
            >
              {pengurus.flagship.title}
            </h3>
            <p class="text-[18px] leading-[29px] text-[#6B7672] font-normal lg:text-[18px] text-[16px]">
              {pengurus.flagship.body}
            </p>
          </div>

          <!-- Screens: two phones in white rounded container -->
          <div class="w-full h-[400px] flex flex-row gap-[24px] pt-[44px] justify-center items-start bg-white rounded-[20px] overflow-hidden">
            <PhoneMockup
              src="/screens/dashboard-pengurus.png"
              alt="Dashboard iuran dan laporan keuangan"
              width={256}
              class="rounded-[33px] shadow-[0px_24px_60px_#0F1A1726] object-cover u-tilt"
            />
            <PhoneMockup
              src="/screens/laporan.png"
              alt="Laporan keuangan komunitas"
              width={256}
              class="rounded-[33px] shadow-[0px_24px_60px_#0F1A1726] object-cover u-tilt"
            />
          </div>
        </article>
      </Reveal>

      <!-- Supporting Features List -->
      <Reveal delay={120}>
        <ul class="flex-1 flex flex-col" role="list">
          {pengurus.features.map((feat, i) => (
            <li class="flex flex-row gap-[20px] py-[24px] items-start border-b border-[#E3E7E5] last:border-b-0 group u-interactive">
              <!-- Icon Tile -->
              <div class="w-[48px] h-[48px] shrink-0 flex items-center justify-center bg-[#EEFBF5] rounded-[14px] u-icon-pop">
                <Fragment set:html={featureIcons[i] ?? featureIcons[0]} />
              </div>
              <!-- Text -->
              <div class="flex-1 flex flex-col gap-[6px]">
                <p class="text-[18px] leading-[25px] text-[#0F1A17] font-semibold">
                  {feat.title}
                </p>
                <p class="text-[16px] leading-[26px] text-[#6B7672] font-normal">
                  {feat.body}
                </p>
              </div>
            </li>
          ))}
        </ul>
      </Reveal>

    </div>
  </div>
</section>
