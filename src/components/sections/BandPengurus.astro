---
import SectionHeader from '../ui/SectionHeader.astro';
import PhoneMockup from '../ui/PhoneMockup.astro';
import Reveal from '../ui/Reveal.astro';
import { pengurus } from '../../data/content.id';

// Icon paths — simple inline SVG stripes matched to each feature
const featureIcons: Record<number, string> = {
  0: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="3" y="3" width="14" height="14" rx="3" stroke="currentColor" stroke-width="1.5"/><path d="M7 10h6M7 7h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`,
  1: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="4" stroke="currentColor" stroke-width="1.5"/><path d="M14 14c0-2.21-2.686-4-6-4s-6 1.79-6 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M16 10v4m-2-2h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`,
  2: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="15.5" cy="14.5" r="2.5" stroke="currentColor" stroke-width="1.5"/></svg>`,
  3: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="3" y="8" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M7 8V6a3 3 0 0 1 6 0v2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`,
  4: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 3v14M3 10h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.5"/></svg>`,
};
---

<section id="untuk-pengurus" class="bg-surface">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 md:py-24">

    <Reveal>
      <SectionHeader
        eyebrow="Untuk Pengurus"
        title={pengurus.heading}
        align="left"
        class="mb-12 max-w-2xl"
      />
    </Reveal>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-start">

      <!-- FLAGSHIP: large card with phone mockup emphasis -->
      <Reveal delay={60}>
        <article
          class="rounded-[var(--radius-lg)] bg-ink-800 text-text-inverse flex flex-col gap-6 p-8 lg:p-10"
          aria-labelledby="pengurus-flagship-title"
        >
          <!-- Phone mockup placeholder centred in card -->
          <div class="flex justify-center">
            <PhoneMockup
              src=""
              alt="Dashboard iuran dan laporan keuangan Sahabat Warga"
              width={220}
            />
          </div>

          <div class="flex flex-col gap-3">
            <h3
              id="pengurus-flagship-title"
              class="font-sans font-bold text-2xl lg:text-3xl text-text-inverse leading-tight"
            >
              {pengurus.flagship.title}
            </h3>
            <p class="font-sans text-base leading-relaxed text-text-inverse">
              {pengurus.flagship.body}
            </p>
          </div>
        </article>
      </Reveal>

      <!-- SUPPORTING: compact feature list — visually tight rows, NOT equal cards -->
      <Reveal delay={120}>
        <ul class="flex flex-col divide-y divide-border" role="list">
          {pengurus.features.map((feat, i) => (
            <li class="flex items-start gap-4 py-5 first:pt-0 last:pb-0">
              <!-- Icon column: fixed width, mint-tinted background disc -->
              <span
                class="mt-0.5 flex-shrink-0 flex items-center justify-center w-9 h-9 rounded-full bg-accent text-on-accent"
                set:html={featureIcons[i] ?? featureIcons[0]}
              />
              <!-- Text column -->
              <div class="flex flex-col gap-0.5">
                <p class="font-sans font-semibold text-base text-text-primary leading-snug">
                  {feat.title}
                </p>
                <p class="font-sans text-sm leading-relaxed text-text-secondary">
                  {feat.body}
                </p>
              </div>
            </li>
          ))}
        </ul>
      </Reveal>

    </div>
  </div>
</section>
