---

<section id="roadmap" class="bg-surface-muted">
  <!--
    Desktop: 2-column flex row with gap-[64px], padding px-[120px] py-[96px]
    Mobile:  single column, reduced padding
  -->
  <div class="flex flex-col lg:flex-row gap-[64px] px-6 py-16 lg:px-[120px] lg:py-[96px]">

    <!-- Left: Header block fixed at 420px on desktop -->
    <Reveal>
      <div class="flex flex-col gap-[16px] w-full lg:w-[420px] lg:shrink-0">
        <!-- Eyebrow -->
        <p
          class="text-[13px] font-bold tracking-[1.2px] text-text-brand uppercase"
          aria-label="Kategori bagian"
        >
          {roadmap.eyebrow}
        </p>

        <!-- Heading -->
        <h2 class="text-[40px] leading-[48px] font-bold tracking-[-0.8px] text-text-primary">
          {roadmap.heading}
        </h2>

        <!-- Subhead -->
        <p class="text-[18px] leading-[29px] font-normal text-text-secondary">
          {roadmap.subhead}
        </p>
      </div>
    </Reveal>

    <!-- Right: Items stack -->
    <div class="flex flex-col gap-[16px] flex-1">
      {roadmap.items.map((item, i) => (
        <Reveal delay={i * 80}>
          <article
            class="flex flex-row gap-[20px] p-[32px] bg-white rounded-[24px] items-start"
            aria-labelledby={`roadmap-item-${i}`}
          >
            <!-- Icon tile -->
            <div
              class="w-[52px] h-[52px] shrink-0 flex items-center justify-center bg-surface-muted rounded-[16px]"
              aria-hidden="true"
            >
              <svg
                viewBox="0 0 14 14"
                preserveAspectRatio="xMidYMid meet"
                xmlns="http://www.w3.org/2000/svg"
                class="w-[26px] h-[26px]"
                aria-hidden="true"
                focusable="false"
              >
                <path
                  d={itemIcons[iconKeys[i]]?.path}
                  fill="#6B7672"
                />
              </svg>
            </div>

            <!-- Text block -->
            <div class="flex flex-col gap-[10px] flex-1">
              <!-- "Segera hadir" badge — R-38: always visible -->
              <div
                class="inline-flex w-fit px-[10px] py-[5px] bg-accent rounded-[8px]"
                role="status"
                aria-label="Status fitur: segera hadir"
              >
                <span class="text-[12px] font-bold text-on-accent whitespace-nowrap leading-normal">
                  Segera hadir
                </span>
              </div>

              <!-- Title -->
              <h3
                id={`roadmap-item-${i}`}
                class="text-[20px] leading-[27px] font-semibold text-text-primary"
              >
                {item.title}
              </h3>

              <!-- Body -->
              <p class="text-[16px] leading-[26px] font-normal text-text-secondary">
                {item.body}
              </p>
            </div>
          </article>
        </Reveal>
      ))}
    </div>

  </div>
</section>
