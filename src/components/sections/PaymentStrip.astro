<!-- Payment Methods Strip
     Desktop: single row, 28px top/bottom padding, 120px left/right padding, justify-between
     Mobile (< lg): stack vertically, 24px padding, badges wrap
-->
<section class="bg-surface-muted">
  <!-- Desktop layout: px-[120px] py-[28px] matches reference exactly -->
  <div class="flex flex-col items-start gap-4 px-6 py-[28px] lg:flex-row lg:items-center lg:justify-between lg:px-[120px] lg:gap-0">

    <!-- Left: headline text -->
    <p class="font-sans text-[18px] font-semibold leading-normal text-text-primary whitespace-nowrap">
      {payment.title}
    </p>

    <!-- Right: payment method badges -->
    <div class="flex flex-wrap items-center gap-[12px]">
      {payment.methods.map((method) => (
        <div class="flex shrink-0 flex-row items-center gap-[8px] rounded-[12px] bg-white px-[16px] py-[10px] outline outline-1 outline-border outline-offset-[-0.5px] u-hover-lift">
          <!-- Icon: 20×20, fill with text-brand (#08745A) -->
          <svg
            viewBox="0 0 14 14"
            preserveAspectRatio="xMidYMid meet"
            xmlns="http://www.w3.org/2000/svg"
            class="h-[20px] w-[20px] shrink-0"
            aria-hidden="true"
          >
            <path d={icons[method]} fill="#08745A" />
          </svg>
          <!-- Label -->
          <span class="font-sans text-[14px] font-semibold leading-normal text-text-primary whitespace-nowrap">
            {method}
          </span>
        </div>
      ))}
    </div>

  </div>
</section>
