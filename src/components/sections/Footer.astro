---
import Button from '../ui/Button.astro';
import { footer } from '../../data/content.id';
import { WA_URL } from '../../config';
---

<footer class="bg-surface border-t border-border">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 md:py-16">

    <div class="flex flex-col gap-10">

      <!-- Top: brand tagline + primary CTA -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-5">
        <div class="flex flex-col gap-1">
          <span class="font-sans font-bold text-xl text-text-primary">Sahabat Warga</span>
          <p class="font-sans text-sm text-text-secondary">{footer.tagline}</p>
        </div>
        <Button
          href="#mulai"
          variant="primary"
          label="Buat Komunitas"
          data-open="waitlist"
          class="self-start sm:self-auto flex-shrink-0"
        />
      </div>

      <!-- Middle: nav links + contact -->
      <nav aria-label="Tautan footer">
      <div class="flex flex-col sm:flex-row gap-8 sm:gap-16">

        <!-- Link groups: only real section anchors -->
        {footer.linkGroups.map((group) => (
          <div class="flex flex-col gap-3">
            <p class="font-sans font-semibold text-xs uppercase tracking-widest text-text-secondary">
              {group.heading}
            </p>
            <ul class="flex flex-col gap-2" role="list">
              {group.links.map((link) => (
                <li>
                  <!-- Text interpolation: Astro auto-escapes & in labels -->
                  <a
                    href={link.href}
                    class="font-sans text-sm text-text-secondary hover:text-text-primary transition-colors duration-150"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}

        <!-- Contact -->
        <div class="flex flex-col gap-3">
          <p class="font-sans font-semibold text-xs uppercase tracking-widest text-text-secondary">
            Kontak
          </p>
          <ul class="flex flex-col gap-2" role="list">
            <li>
              <a
                href={WA_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="font-sans text-sm text-text-secondary hover:text-text-primary transition-colors duration-150"
              >
                WhatsApp
              </a>
            </li>
            <li>
              <a
                href={`mailto:${footer.contact.email}`}
                class="font-sans text-sm text-text-secondary hover:text-text-primary transition-colors duration-150"
              >
                {footer.contact.email}
              </a>
            </li>
          </ul>
        </div>

      </div>
      </nav>

      <!-- Bottom: legal + copyright -->
      <div class="border-t border-border pt-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <p class="font-sans text-xs text-text-secondary">
          {footer.copyright}
        </p>
        <ul class="flex flex-wrap gap-4" role="list">
          {footer.legal.map((link) => (
            <li>
              <!-- Text interpolation: Astro auto-escapes & in "Syarat & Ketentuan" -->
              <a
                href={link.href}
                class="font-sans text-xs text-text-secondary hover:text-text-primary transition-colors duration-150"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

    </div>

  </div>
</footer>
