---
import SectionHeader from '../ui/SectionHeader.astro';
import Reveal from '../ui/Reveal.astro';
import { caraKerja } from '../../data/content.id';
---

<section id="cara-kerja" class="bg-bg">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 md:py-24">

    <Reveal>
      <SectionHeader
        eyebrow="Cara Kerja"
        title={caraKerja.heading}
        align="center"
        class="mb-16 mx-auto max-w-2xl"
      />
    </Reveal>

    <!-- Steps: numbered with connecting line on md+ -->
    <ol class="relative flex flex-col md:flex-row md:items-start gap-10 md:gap-0" role="list">
      {caraKerja.steps.map((step, i) => (
        <Reveal delay={i * 100} as="li" class="flex-1 flex flex-col items-center text-center relative md:px-6">

          <!-- Connecting line between steps (horizontal on md+) -->
          {i < caraKerja.steps.length - 1 && (
            <span
              class="hidden md:block absolute top-7 left-1/2 w-full h-px bg-border"
              aria-hidden="true"
            />
          )}

          <!-- Step number circle -->
          <div
            class="relative z-10 flex items-center justify-center w-14 h-14 rounded-full bg-primary text-on-primary font-sans font-bold text-xl mb-5 flex-shrink-0"
            aria-hidden="true"
          >
            {i + 1}
          </div>

          <!-- Step content -->
          <div class="flex flex-col gap-2 max-w-xs">
            <h3 class="font-sans font-bold text-lg text-text-primary leading-snug">
              {step.title}
            </h3>
            <p class="font-sans text-sm leading-relaxed text-text-secondary">
              {step.body}
            </p>
          </div>

        </Reveal>
      ))}
    </ol>

  </div>
</section>
