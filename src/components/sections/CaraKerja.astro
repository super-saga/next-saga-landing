---
import { caraKerja } from '../../data/content.id';
---

<section id="cara-kerja" class="bg-bg w-full">
  <div
    class="box-border w-full flex flex-col gap-[56px] py-[112px] px-[120px] max-lg:py-16 max-lg:px-6 max-md:py-12 max-md:px-4"
  >
    <!-- Header -->
    <div class="flex flex-col gap-[16px] w-full max-w-[760px]">
      <p
        class="text-[13px] font-bold tracking-[1.2px] text-[#08745A] uppercase"
      >
        CARA KERJA
      </p>
      <h2
        class="text-[40px] leading-[48px] font-bold tracking-[-0.8px] text-[#0F1A17] max-md:text-[28px] max-md:leading-[36px]"
      >
        {caraKerja.heading}
      </h2>
      <p class="text-[18px] leading-[29px] text-[#6B7672] font-normal max-md:text-base">
        Dari daftar sampai berjalan, alurnya sama seperti di aplikasi.
      </p>
    </div>

    <!-- Steps -->
    <div
      class="flex flex-row gap-[24px] w-full items-start max-md:flex-col"
    >

      <!-- Step 1 -->
      <div class="flex-1 flex flex-col gap-[20px] items-start min-w-0">
        <!-- Visual: Join -->
        <div
          class="w-full h-[240px] shrink-0 flex flex-col gap-[12px] p-[28px] justify-center items-start bg-white [outline:1px_solid_#E3E7E5] [outline-offset:-0.5px] rounded-[24px]"
