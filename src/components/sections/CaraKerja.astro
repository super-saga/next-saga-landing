        <div class="w-full flex flex-row gap-[12px] items-center">
          <span class="text-[14px] font-bold text-[#08745A] whitespace-nowrap">Langkah 1</span>
          <div class="flex-1 h-[2px] bg-[#5FD4AE]"></div>
        </div>

        <!-- Title -->
        <h3 class="text-[20px] leading-[27px] font-semibold text-[#0F1A17] w-full text-left">
          {caraKerja.steps[0].title}
