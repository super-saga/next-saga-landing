          <div
            class="w-full flex flex-row gap-[10px] p-[12px_14px] items-center bg-[#0E9F76] rounded-[14px]"
          >
            <!-- add_home icon -->
            <svg
              viewBox="0 0 14 14"
              preserveAspectRatio="xMidYMid meet"
              xmlns="http://www.w3.org/2000/svg"
              class="w-[20px] h-[20px] shrink-0"
              aria-hidden="true"
            >
