            <!-- chevron_right icon -->
            <svg
              viewBox="0 0 14 14"
              preserveAspectRatio="xMidYMid meet"
              xmlns="http://www.w3.org/2000/svg"
              class="w-[18px] h-[18px] shrink-0"
              aria-hidden="true"
            >
