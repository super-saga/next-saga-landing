---
import { nav } from '../../data/content.id';
---

<header class="sticky top-0 z-40 bg-surface border-b border-border">
  {/* Desktop nav — pixel-matches 01-nav.html reference at 1440px */}
  <nav
    class="hidden lg:flex flex-row items-center justify-between h-[79.5px] px-[120px]"
    aria-label="Navigasi utama"
  >
    {/* Logo lockup (sahabat warga) */}
    <a href="/" class="flex flex-row items-center no-underline shrink-0 u-press" aria-label={nav.brand}>
      <img
        src="/brand/logo.webp"
        alt={nav.brand}
        width="155"
        height="40"
        class="h-9 w-auto object-contain"
      />
    </a>

    {/* Right: links + CTA */}
    <div class="flex flex-row items-center gap-[40px] shrink-0">
      {/* Nav links */}
      <ul class="flex flex-row items-center gap-[32px] list-none m-0 p-0">
        {nav.links.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-[15px] leading-normal font-semibold text-ink-700 whitespace-nowrap no-underline hover:text-text-primary transition-colors font-sans u-underline"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      {/* CTA — Buat Komunitas */}
      <a
        href="#mulai"
        data-open="waitlist"
        class="inline-flex items-center justify-center h-[44px] px-[22px] bg-primary rounded-[999px] text-[15px] leading-normal font-bold text-on-primary whitespace-nowrap no-underline hover:opacity-90 transition-opacity shrink-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-primary font-sans"
      >
        {nav.primaryCta.label}
      </a>
    </div>
  </nav>

  {/* Mobile nav */}
  <nav class="lg:hidden" aria-label="Navigasi utama">
    <div class="flex items-center justify-between h-16 px-4 sm:px-6">
      {/* Logo lockup */}
      <a href="/" class="flex flex-row items-center no-underline shrink-0 u-press" aria-label={nav.brand}>
        <img
          src="/brand/logo.webp"
          alt={nav.brand}
          width="140"
          height="36"
          class="h-8 w-auto object-contain"
        />
      </a>

      {/* Hamburger */}
      <button
        id="nav-toggle"
        class="flex items-center justify-center w-11 h-11 rounded-md text-text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        aria-expanded="false"
        aria-controls="nav-mobile-menu"
        aria-label="Buka menu navigasi"
        type="button"
      >
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true" class="nav-icon-open">
          <rect y="3" width="22" height="2.5" rx="1.25" fill="currentColor" />
          <rect y="9.75" width="22" height="2.5" rx="1.25" fill="currentColor" />
          <rect y="16.5" width="22" height="2.5" rx="1.25" fill="currentColor" />
        </svg>
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true" class="nav-icon-close hidden">
          <path d="M3 3L19 19M19 3L3 19" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    {/* Mobile menu */}
    <div
      id="nav-mobile-menu"
      class="hidden"
      role="region"
      aria-label="Menu navigasi mobile"
    >
      <ul class="flex flex-col gap-1 list-none m-0 px-4 sm:px-6 pb-4">
        {nav.links.map((link) => (
          <li>
            <a
              href={link.href}
              class="block py-2.5 px-2 text-base font-semibold text-ink-700 hover:text-text-primary transition-colors no-underline font-sans u-underline"
            >
              {link.label}
            </a>
          </li>
        ))}
        <li class="pt-2">
          <a
            href="#mulai"
            data-open="waitlist"
            class="inline-flex w-full items-center justify-center h-[44px] px-[22px] bg-primary rounded-[999px] text-[15px] leading-normal font-bold text-on-primary no-underline hover:opacity-90 transition-opacity focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary font-sans"
          >
            {nav.primaryCta.label}
          </a>
        </li>
      </ul>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-mobile-menu');
  const iconOpen = toggle?.querySelector('.nav-icon-open');
  const iconClose = toggle?.querySelector('.nav-icon-close');

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });
</script>
