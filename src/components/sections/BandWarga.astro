---
import Sobi from '../sobi/Sobi.astro';
import { warga } from '../../data/content.id';

// Real app screens per warga feature row — order matches reference row order.
// Row 1: Bayar Iuran  Row 2: Pengumuman  Row 3: Laporan  Row 4: QR Akses  Row 5: Polling
const wargaScreens = [
  '/screens/tagihan.png',
  '/screens/pengumuman.png',
  '/screens/laporan.png',
  '/screens/qr-akses.png',
  '/screens/polling.png',
];

