---

<section id="untuk-warga" class="bg-[#F6F7F6]">
  <div class="px-4 sm:px-8 lg:px-[120px] py-12 sm:py-16 lg:py-[112px] flex flex-col gap-12 lg:gap-[72px]">

    <!-- Header -->
    <div class="w-full lg:max-w-[880px] flex flex-col gap-[16px]">
      <p class="text-[13px] leading-normal font-bold tracking-[1.2px] uppercase text-text-brand">
        UNTUK WARGA
      </p>
      <h2 class="text-[28px] lg:text-[40px] leading-tight lg:leading-[48px] font-bold tracking-[-0.8px] text-ink-900">
        {warga.heading}
      </h2>
      <p class="text-[16px] lg:text-[18px] leading-[29px] text-text-secondary font-normal">
        Warga bergabung lewat undangan pengurus, lalu semua urusan sehari-hari bisa diselesaikan
        tanpa antre atau tanya sana-sini.
      </p>
    </div>

    <!-- Carousel region (vertical) -->
    <div
      id="warga-carousel"
      role="group"
      aria-roledescription="carousel"
      aria-label="Fitur untuk warga"
      class="flex flex-row items-stretch gap-4 lg:gap-6"
    >
      <!-- Vertical track -->
      <div
        id="warga-track"
        class="warga-track flex-1 min-w-0 flex flex-col gap-4 overflow-y-auto overscroll-y-contain h-[320px] sm:h-[420px] lg:h-[440px]"
        style="scroll-snap-type: y mandatory; scroll-behavior: smooth; -webkit-overflow-scrolling: touch;"
      >
        {warga.features.map((feat, i) => (
          <div
            id={`warga-slide-${i}`}
            role="group"
            aria-roledescription="slide"
            aria-label={`${i + 1} dari 5: ${feat.title}`}
            class="warga-slide flex-none w-full h-[320px] sm:h-[420px] lg:h-[440px] flex flex-row rounded-[20px] overflow-hidden bg-white [box-shadow:0_2px_12px_0_rgba(0,0,0,0.07)]"
            style="scroll-snap-align: start;"
          >
            <!-- Phone visual area: mint bg; phone is taller than the card so it crops at the bottom (screen reads big, like pen.dev) -->
            <div class="bg-[#EEFBF5] flex justify-center items-start pt-6 lg:pt-9 overflow-hidden w-[150px] sm:w-[290px] lg:w-[390px] shrink-0">
              <img
                src={wargaScreens[i]}
                alt={`Layar ${feat.title} di aplikasi Sahabat Warga`}
                class="block h-auto w-[140px] sm:w-[260px] lg:w-[330px] shrink-0"
                loading="lazy"
                decoding="async"
              />
            </div>
            <!-- Card body -->
            <div class="flex-1 min-w-0 flex flex-col justify-center gap-4 p-6 lg:p-12">
              <!-- Icon tile -->
              <div class="w-[48px] h-[48px] shrink-0 flex items-center justify-center bg-white rounded-[14px] [outline:1px_solid_#E3E7E5] [outline-offset:-0.5px]">
                <svg
                  viewBox="0 0 14 14"
                  preserveAspectRatio="xMidYMid meet"
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-[24px] h-[24px] shrink-0"
                  aria-hidden="true"
                  set:html={icons[i]}
                />
              </div>
              <h3 class="text-[20px] lg:text-[28px] leading-tight lg:leading-[34px] font-bold tracking-[-0.4px] text-ink-900">
                {feat.title}
              </h3>
              <p class="text-[15px] lg:text-[17px] leading-[24px] lg:leading-[27px] text-text-secondary font-normal">
                {feat.body}
              </p>
            </div>
          </div>
        ))}
      </div>

      <!-- Vertical controls rail: up / dots / down -->
      <div class="flex flex-col items-center justify-center gap-4 shrink-0">
        <!-- Up button -->
        <button
          id="warga-prev"
          aria-label="Sebelumnya"
          class="u-press flex items-center justify-center w-10 h-10 rounded-full bg-white [box-shadow:0_1px_6px_0_rgba(0,0,0,0.10)] text-ink-900 shrink-0 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-text-brand"
        >
          <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" aria-hidden="true">
            <path d="M5 12.5L10 7.5L15 12.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <!-- Dot indicators (vertical) -->
        <div id="warga-dots" class="flex flex-col items-center gap-2" aria-label="Slide navigator">
          {warga.features.map((feat, i) => (
            <button
              class="warga-dot w-2 h-2 rounded-full bg-[#C9D6D1] transition-all duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-text-brand"
              aria-label={`${i + 1} dari 5: ${feat.title}`}
              aria-current={i === 0 ? 'true' : 'false'}
              data-index={i}
            />
          ))}
        </div>

        <!-- Down button -->
        <button
          id="warga-next"
          aria-label="Berikutnya"
          class="u-press flex items-center justify-center w-10 h-10 rounded-full bg-white [box-shadow:0_1px_6px_0_rgba(0,0,0,0.10)] text-ink-900 shrink-0 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-text-brand"
        >
          <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" aria-hidden="true">
            <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Sobi Highlight Block — unchanged -->
    <div class="w-full lg:h-[460px] flex flex-col lg:flex-row items-center lg:items-center gap-8 lg:gap-[64px] px-6 py-10 lg:pl-[72px] lg:pr-[56px] lg:py-0 bg-[#06372A] rounded-[32px] overflow-hidden">

      {/* Copy */}
      <div class="w-full lg:flex-1 flex flex-col gap-[18px] text-center lg:text-left items-center lg:items-start">
        {/* Sobi mascot tile */}
        <div class="w-[132px] h-[132px] shrink-0 flex items-center justify-center">
          <Sobi size={132} />
        </div>
        <h3 class="text-[24px] lg:text-[32px] leading-[38px] font-bold tracking-[-0.5px] text-white w-full">
          {warga.sobi.title}
        </h3>
        <p class="text-[16px] lg:text-[18px] leading-[29px] text-[#C9F5E4] font-normal w-full">
          {warga.sobi.body}
        </p>
      </div>

      {/* Phone area */}
      <div class="w-full lg:w-[460px] lg:h-full shrink-0 flex justify-center items-start pt-0 lg:pt-[56px]">
        <img
          src="/screens/tagihan.png"
          alt="Sobi membantu cek tagihan di aplikasi Sahabat Warga"
          class="block h-auto w-[220px] lg:w-[300px] shrink-0"
          loading="lazy"
          decoding="async"
        />
      </div>

    </div>

  </div>
</section>

<style>
  /* Hide scrollbar cross-browser while keeping scroll functionality */
  .warga-track {
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE/Edge */
  }
  .warga-track::-webkit-scrollbar {
    display: none; /* Chrome/Safari/WebKit */
  }

  /* Active dot state (vertical rail: elongate vertically) */
  .warga-dot[aria-current="true"] {
    background-color: #08745A;
    height: 20px;
  }
</style>

<script>
  (function () {
    const SLIDE_COUNT = 5;
    const INTERVAL_MS = 4000;

    const track = document.getElementById('warga-track') as HTMLElement | null;
    const prevBtn = document.getElementById('warga-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('warga-next') as HTMLButtonElement | null;
    const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.warga-dot'));
    const carousel = document.getElementById('warga-carousel') as HTMLElement | null;

    if (!track || !prevBtn || !nextBtn || !carousel) return;

    // Respect reduced motion: disable auto-advance and smooth scroll
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      track.style.scrollBehavior = 'auto';
    }

    // --- Slide height helper (vertical) ---
    function getSlideHeight(): number {
      const firstSlide = track!.querySelector<HTMLElement>('.warga-slide');
      if (!firstSlide) return 0;
      const style = window.getComputedStyle(track!);
      const gap = parseFloat(style.rowGap) || 16;
      return firstSlide.offsetHeight + gap;
    }

    // --- Current index detection via scroll position (vertical) ---
    function getCurrentIndex(): number {
      const slideH = getSlideHeight();
      if (slideH === 0) return 0;
      return Math.round(track!.scrollTop / slideH);
    }

    // --- Scroll to a specific index (vertical) ---
    function scrollToIndex(index: number, smooth = true) {
      const clampedIndex = Math.max(0, Math.min(SLIDE_COUNT - 1, index));
      const slideH = getSlideHeight();
      track!.style.scrollBehavior = (prefersReducedMotion || !smooth) ? 'auto' : 'smooth';
      track!.scrollTop = clampedIndex * slideH;
    }

    // --- Update dot indicators ---
    function updateDots(activeIndex: number) {
      dots.forEach((dot, i) => {
        const isActive = i === activeIndex;
        dot.setAttribute('aria-current', isActive ? 'true' : 'false');
      });
    }

    // --- Observe scroll to sync dots ---
    let scrollTimer: ReturnType<typeof setTimeout>;
    track.addEventListener('scroll', () => {
      clearTimeout(scrollTimer);
      scrollTimer = setTimeout(() => {
        updateDots(getCurrentIndex());
      }, 80);
    }, { passive: true });

    // --- Prev / Next buttons ---
    prevBtn.addEventListener('click', () => {
      const current = getCurrentIndex();
      const next = current <= 0 ? SLIDE_COUNT - 1 : current - 1;
      scrollToIndex(next);
    });

    nextBtn.addEventListener('click', () => {
      const current = getCurrentIndex();
      const next = current >= SLIDE_COUNT - 1 ? 0 : current + 1;
      scrollToIndex(next);
    });

    // --- Dot clicks ---
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => scrollToIndex(i));
    });

    // --- Keyboard navigation on carousel region (vertical: Up/Down) ---
    carousel.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowUp') {
        e.preventDefault();
        const current = getCurrentIndex();
        scrollToIndex(current <= 0 ? SLIDE_COUNT - 1 : current - 1);
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        const current = getCurrentIndex();
        scrollToIndex(current >= SLIDE_COUNT - 1 ? 0 : current + 1);
      }
    });

    // --- Auto-advance ---
    if (prefersReducedMotion) return; // no timer if reduced motion

    let timer: ReturnType<typeof setInterval> | null = null;
    let paused = false;

    function startTimer() {
      if (timer !== null) return;
      timer = setInterval(() => {
        if (paused) return;
        const current = getCurrentIndex();
        const next = current >= SLIDE_COUNT - 1 ? 0 : current + 1;
        scrollToIndex(next);
      }, INTERVAL_MS);
    }

    function stopTimer() {
      if (timer !== null) {
        clearInterval(timer);
        timer = null;
      }
    }

    function pause() {
      paused = true;
    }

    function resume() {
      paused = false;
    }

    // Pause on pointer hover
    carousel.addEventListener('mouseenter', pause);
    carousel.addEventListener('mouseleave', resume);

    // Pause on focus within
    carousel.addEventListener('focusin', pause);
    carousel.addEventListener('focusout', resume);

    // Pause when tab/window is hidden
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        pause();
      } else {
        resume();
      }
    });

    // Pause when carousel is off-screen (IntersectionObserver)
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            resume();
            startTimer();
          } else {
            pause();
            stopTimer();
          }
        });
      },
      { threshold: 0.1 }
    );
    observer.observe(carousel);

    // Start auto-advance once visible check runs naturally via observer
    // Also start immediately if already visible
    if (carousel.getBoundingClientRect().top < window.innerHeight) {
      startTimer();
    }
  })();
</script>
