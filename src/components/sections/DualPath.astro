---
import Reveal from '../ui/Reveal.astro';
import { dualPath } from '../../data/content.id';

// Highlight rows for Pengurus card (from reference)
const pengurusHighlights = [
  'Iuran & laporan',
  'Data warga',
  'Broadcast WA',
  'Akses satpam',
];

// Check-circle SVG path (Material Symbols Rounded, 14x14 viewBox)
const checkCirclePath =
  'M6.1626 8.45264l-1.45948-1.45606q-0.07861-0.08203-0.19824-0.08545-0.11963-0.00684-0.21191 0.08545-0.0957 0.0957-0.0957 0.2085 0 0.11279 0.0957 0.20508l1.53808 1.53808q0.14014 0.14355 0.32813 0.14356 0.19141 0 0.33154-0.14356l3.1958-3.19238q0.08203-0.08203 0.08545-0.20166 0.00684-0.11963-0.08545-0.21191-0.0957-0.09229-0.20849-0.09229-0.11279 0-0.20508 0.09229l-3.11035 3.11035z m0.84082 3.79736q-1.09033 0-2.05078-0.41357-0.95703-0.41357-1.66797-1.1211-0.70752-0.70752-1.1211-1.66455-0.41357-0.96045-0.41357-2.04736 0-1.09033 0.41357-2.04737 0.41357-0.96045 1.1211-1.66796 0.70752-0.71094 1.66455-1.12452 0.96045-0.41357 2.04736-0.41357 1.09033 0 2.04737 0.41357 0.96045 0.41357 1.66796 1.1211 0.71094 0.70752 1.12452 1.66797 0.41357 0.95703 0.41357 2.04394 0 1.09033-0.41357 2.05078-0.41357 0.95703-1.1211 1.66797-0.70752 0.70752-1.66797 1.1211-0.95703 0.41357-2.04394 0.41357z m-0.00342-0.58447q1.95508 0 3.30859-1.35352 1.35693-1.35693 1.35694-3.31201 0-1.95508-1.35694-3.30859-1.35352-1.35693-3.30859-1.35694-1.95508 0-3.31201 1.35694-1.35352 1.35352-1.35352 3.30859 0 1.95508 1.35352 3.31201 1.35693 1.35352 3.31201 1.35352z';
---

<section id="fitur" class="bg-bg">
  <!-- Desktop: py-[112px] px-[120px] | Tablet: py-16 px-8 | Mobile: py-12 px-4 -->
  <div class="px-4 py-12 sm:px-8 sm:py-16 lg:px-[120px] lg:py-[112px]">

    <!-- Section Header — left-aligned, max 800px wide -->
    <Reveal>
      <div class="flex flex-col gap-[16px] mb-[48px] max-w-[800px]">
        <p
          class="text-[13px] font-bold tracking-[1.2px] text-text-brand uppercase leading-normal whitespace-nowrap"
        >
          SATU APLIKASI, DUA PERAN
        </p>
        <h2
          class="font-bold text-[28px] leading-[1.2] tracking-[-0.4px] text-ink-900 md:text-[40px] md:leading-[48px] md:tracking-[-0.8px]"
        >
          {dualPath.title}
        </h2>
        <p class="text-[18px] leading-[29px] text-text-secondary font-normal">
          Pengurus mengelola, warga ikut terlibat. Keduanya bekerja di aplikasi yang sama.
        </p>
      </div>
    </Reveal>

    <!-- Cards row -->
    <div class="flex flex-col gap-6 lg:flex-row lg:gap-[24px] lg:items-stretch">

      <!-- ── Pengurus card — ink-800, dominant (720px) ── -->
      <Reveal delay={60}>
        <article
          class="flex flex-col justify-between gap-[24px] rounded-[32px] bg-[#1B2724] p-8 sm:p-10 lg:w-[720px] lg:shrink-0 lg:h-[420px] lg:p-[48px]"
        >
          <!-- Top block -->
          <div class="flex flex-col gap-[20px]">

            <!-- Icon Tile -->
            <div
              class="w-[56px] h-[56px] shrink-0 flex items-center justify-center bg-primary rounded-[16px]"
              aria-hidden="true"
            >
              <!-- admin_panel_settings — Material Symbols Rounded -->
              <svg
                viewBox="0 0 14.000015258789062 14"
                preserveAspectRatio="xMidYMid meet"
                xmlns="http://www.w3.org/2000/svg"
                class="w-[28px] h-[28px]"
                aria-hidden="true"
              >
                <path
                  d="M7 1.85938q0.08203 0 0.16406 0.01708 0.08545 0.01367 0.16406 0.04444l3.14112 1.16894q0.27344 0.10596 0.44433 0.34864 0.1709 0.23926 0.1709 0.53662l0 2.2832q0 0.12646-0.08545 0.21191-0.08203 0.08203-0.20849 0.08204-0.12305 0-0.2085-0.08204-0.08203-0.08545-0.08203-0.21191l0-2.29004q0-0.11279-0.06152-0.20166-0.06152-0.08887-0.17432-0.1333l-3.14111-1.16894q-0.05469-0.02051-0.12305-0.02051-0.06836 0-0.12305 0.02051l-3.14111 1.16894q-0.11279 0.04443-0.17432 0.1333-0.06152 0.08887-0.06152 0.20166l0 2.50537q0 0.84424 0.24268 1.63379 0.24609 0.78955 0.68017 1.45264 0.43408 0.66309 1.01514 1.15869 0.58447 0.4956 1.25781 0.77588 0.11621 0.05127 0.1709 0.16406 0.05811 0.10938 0.01709 0.22559-0.04785 0.12305-0.16748 0.16748-0.11963 0.04101-0.22559-0.00684-1.63721-0.69385-2.60791-2.2456-0.96729-1.55518-0.96728-3.32569l0-2.49853q0-0.29736 0.1709-0.53662 0.1709-0.24268 0.44433-0.34864l3.14112-1.16894q0.08203-0.0376 0.16406-0.04785 0.08203-0.01367 0.16406-0.01368z m2.91553 10.39062q-0.97412 0-1.6543-0.67676-0.67676-0.68018-0.67676-1.65771 0-0.97412 0.67676-1.65088 0.68018-0.68018 1.6543-0.68018 0.97754 0 1.65429 0.68018 0.68018 0.67676 0.68018 1.65088 0 0.97754-0.68018 1.65771-0.67676 0.67676-1.65429 0.67676z m0-2.33447q0.36572 0 0.61865-0.25293 0.25635-0.25635 0.25635-0.62207 0-0.3623-0.25635-0.61865-0.25293-0.25635-0.61865-0.25635-0.3623 0-0.61865 0.25635-0.25635 0.25635-0.25635 0.61865 0 0.36572 0.25635 0.62207 0.25635 0.25293 0.61865 0.25293z m0 1.75q0.37598 0 0.71777-0.14356 0.34522-0.14355 0.59473-0.42724 0.06152-0.07861 0.04101-0.16407-0.02051-0.08887-0.10254-0.1333-0.29053-0.15381-0.6084-0.22558-0.31787-0.07178-0.64257-0.07178-0.32813 0-0.646 0.07178-0.31445 0.07178-0.60156 0.22558-0.08203 0.04443-0.10254 0.1333-0.02051 0.08545 0.04102 0.16407 0.24951 0.28369 0.5913 0.42724 0.3418 0.14355 0.71778 0.14356z"
                  fill="#FFFFFF"
                ></path>
              </svg>
            </div>

            <!-- Eyebrow -->
            <p
              class="text-[13px] font-bold tracking-[1.2px] leading-normal whitespace-nowrap text-[#5FD4AE] uppercase"
            >
              KETUA RT/RW &amp; PENGURUS
            </p>

            <!-- Title -->
            <h3
              class="font-bold text-[28px] leading-tight tracking-[-0.4px] text-white md:text-[36px] md:leading-[43px] md:tracking-[-0.6px]"
            >
              {dualPath.pengurus.title}
            </h3>

            <!-- Body -->
            <p class="text-[18px] leading-[29px] font-normal text-[#E3E7E5]">
              {dualPath.pengurus.body}
            </p>

            <!-- Highlights row -->
            <div class="flex flex-wrap gap-x-[20px] gap-y-[12px] pt-[4px]">
              {pengurusHighlights.map((label) => (
                <div class="flex flex-row items-center gap-[6px] shrink-0">
                  <svg
                    viewBox="0 0 14.000015258789062 14"
                    preserveAspectRatio="xMidYMid meet"
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-[18px] h-[18px] shrink-0"
                    aria-hidden="true"
                  >
                    <path d={checkCirclePath} fill="#5FD4AE"></path>
                  </svg>
                  <span class="text-[14px] font-semibold leading-normal whitespace-nowrap text-[#E3E7E5]">
                    {label}
                  </span>
                </div>
              ))}
            </div>

          </div>

          <!-- CTA pill -->
          <div>
            <a
              href="#mulai"
              data-open="waitlist"
              class="inline-flex items-center justify-center h-[52px] px-[28px] rounded-full bg-primary text-white font-bold text-[16px] leading-none whitespace-nowrap transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-primary"
            >
              {dualPath.pengurus.cta}
            </a>
          </div>
        </article>
      </Reveal>

      <!-- ── Warga card — mint surface, flex-1 ── -->
      <Reveal delay={120}>
        <article
          class="flex flex-col justify-between gap-[24px] rounded-[32px] bg-[#C9F5E4] p-8 sm:p-10 lg:flex-1 lg:h-[420px] lg:p-[48px]"
        >
          <!-- Top block -->
          <div class="flex flex-col gap-[20px]">

            <!-- Icon Tile -->
            <div
              class="w-[56px] h-[56px] shrink-0 flex items-center justify-center bg-white rounded-[16px]"
              aria-hidden="true"
            >
              <!-- home — Material Symbols Rounded -->
              <svg
                viewBox="0 0 14.000015258789062 14"
                preserveAspectRatio="xMidYMid meet"
                xmlns="http://www.w3.org/2000/svg"
                class="w-[28px] h-[28px]"
                aria-hidden="true"
              >
                <path
                  d="M3.5 11.08447l2.15332 0 0-2.96338q0-0.19824 0.1333-0.33496 0.13672-0.13672 0.33838-0.13672l1.75 0q0.20166 0 0.33496 0.13672 0.13672 0.13672 0.13672 0.33496l0 2.96338 2.15332 0 0-5.07226q0-0.08887-0.04102-0.16065-0.0376-0.0752-0.10595-0.12988l-3.14112-2.36865q-0.08887-0.07861-0.21191-0.07862-0.12305 0-0.21191 0.07862l-3.14112 2.36865q-0.06836 0.05469-0.10937 0.12988-0.0376 0.07178-0.0376 0.16065l0 5.07226z m-0.58447 0l0-5.07226q0-0.22217 0.09912-0.42041 0.10254-0.20166 0.28027-0.33155l3.14112-2.3789q0.24609-0.18799 0.56054-0.18799 0.31787 0 0.56738 0.18799l3.14112 2.3789q0.17773 0.12988 0.27685 0.33155 0.10254 0.19824 0.10254 0.42041l0 5.07226q0 0.23242-0.17431 0.40674-0.17432 0.17432-0.41016 0.17432l-2.26611 0q-0.20166 0-0.33838-0.1333-0.1333-0.13672-0.1333-0.33838l0-2.95996-1.52442 0 0 2.95996q0 0.20166-0.13672 0.33838-0.1333 0.1333-0.33496 0.1333l-2.26611 0q-0.23584 0-0.41016-0.17432-0.17432-0.17432-0.17431-0.40674z"
                  fill="#08745A"
                ></path>
              </svg>
            </div>

            <!-- Eyebrow -->
            <p
              class="text-[13px] font-bold tracking-[1.2px] leading-normal whitespace-nowrap text-[#08745A] uppercase"
            >
              WARGA, LEWAT UNDANGAN
            </p>

            <!-- Title -->
            <h3
              class="font-bold text-[28px] leading-tight tracking-[-0.4px] text-[#06372A] md:text-[36px] md:leading-[43px] md:tracking-[-0.6px]"
            >
              {dualPath.warga.title}
            </h3>

            <!-- Body -->
            <p class="text-[18px] leading-[29px] font-normal text-[#06372A]">
              {dualPath.warga.body}
            </p>

          </div>

          <!-- CTA pill — white bg, border -->
          <div>
            <a
              href="#mulai"
              data-open="waitlist"
              class="inline-flex items-center justify-center h-[52px] px-[28px] rounded-full bg-white border border-[#E3E7E5] text-[#0F1A17] font-bold text-[16px] leading-none whitespace-nowrap transition-colors hover:bg-[#EEFBF5] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-primary"
            >
              {dualPath.warga.cta}
            </a>
          </div>
        </article>
      </Reveal>

    </div>
  </div>
</section>
