---
import Button from '../ui/Button.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Reveal from '../ui/Reveal.astro';
import { dualPath } from '../../data/content.id';
---

<section id="fitur" class="bg-bg">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 md:py-24">

    <Reveal>
      <SectionHeader
        title={dualPath.title}
        align="center"
        class="mb-12"
      />
    </Reveal>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-6">

      <!-- Pengurus card: DOMINANT — ink surface, 3/5 width on desktop -->
      <Reveal delay={60} class="lg:col-span-3">
        <article
          class="h-full rounded-[var(--radius-lg)] bg-ink-800 text-text-inverse flex flex-col gap-6 p-8 lg:p-12"
        >
          <div class="flex flex-col gap-3">
            <h3 class="font-sans font-bold text-2xl lg:text-4xl text-text-inverse leading-tight">
              {dualPath.pengurus.title}
            </h3>
            <p class="font-sans text-base leading-relaxed text-text-inverse/90">
              {dualPath.pengurus.body}
            </p>
          </div>
          <div class="mt-auto pt-2">
            <Button
              href="#mulai"
              label={dualPath.pengurus.cta}
              variant="primary"
              data-open="waitlist"
            />
          </div>
        </article>
      </Reveal>

      <!-- Warga card: secondary — mint surface, 2/5 width on desktop -->
      <Reveal delay={120} class="lg:col-span-2">
        <article
          class="h-full rounded-[var(--radius-lg)] bg-accent text-on-accent flex flex-col gap-6 p-8 lg:p-10"
        >
          <div class="flex flex-col gap-3">
            <h3 class="font-sans font-bold text-2xl lg:text-3xl text-on-accent leading-tight">
              {dualPath.warga.title}
            </h3>
            <p class="font-sans text-base leading-relaxed text-on-accent">
              {dualPath.warga.body}
            </p>
          </div>
          <div class="mt-auto pt-2">
            <Button
              href="#mulai"
              label={dualPath.warga.cta}
              variant="secondary"
              data-open="waitlist"
            />
          </div>
        </article>
      </Reveal>

    </div>
  </div>
</section>
