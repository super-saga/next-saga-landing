---

<!-- 11 · Testimoni -->
<section id="testimoni" class="bg-surface">
  <!-- Desktop: 112px top/bottom, 120px left/right. Mobile: 48px top/bottom, 20px sides -->
  <div class="flex flex-col gap-[48px] py-[112px] px-[120px] max-lg:py-16 max-lg:px-5 max-md:py-12 max-md:px-4">

    <!-- Head: header left + placeholder notice right -->
    <div class="flex flex-row justify-between items-end gap-6 max-lg:flex-col max-lg:items-start">

      <!-- Header -->
      <div class="w-[620px] shrink-0 flex flex-col gap-[16px] max-lg:w-full">
        <!-- Eyebrow -->
        <p class="text-[13px] leading-normal text-text-brand font-bold tracking-[1.2px] whitespace-nowrap">
          TESTIMONI
        </p>
        <!-- Heading -->
        <h2 class="text-[40px] leading-[48px] text-ink-900 font-bold tracking-[-0.8px] max-md:text-[28px] max-md:leading-[36px]">
          {testimoni.heading}
        </h2>
      </div>

      <!-- Placeholder Notice (honesty R-18 — keep visible) -->
      <div
        class="w-[420px] shrink-0 flex flex-row gap-[10px] p-[14px_16px] bg-surface-muted rounded-[12px] max-lg:w-full"
        role="note"
        aria-label="Status konten"
      >
        <!-- Info icon -->
        <svg
          viewBox="0 0 14.000015258789062 14"
          preserveAspectRatio="xMidYMid meet"
          xmlns="http://www.w3.org/2000/svg"
          class="w-[18px] shrink-0 h-[18px] mt-[1px]"
          aria-hidden="true"
        >
          <path d={infoPathD} fill="#6B7672"></path>
        </svg>
        <p class="text-[13px] leading-[20px] text-text-secondary font-medium flex-1">
          Konten contoh. Kutipan di bawah fiktif dan wajib diganti dengan testimoni terverifikasi
          sebelum halaman terbit.
        </p>
      </div>
    </div>

    <!-- Cards row -->
    <div class="flex flex-row gap-[24px] max-lg:flex-col">
      {testimoni.items.map((item, i) => (
        <article
          class={[
            'flex-1 h-[320px] flex flex-col gap-[24px] p-[32px] justify-between items-start rounded-[24px]',
            cardBg[i % cardBg.length],
            'max-lg:h-auto max-lg:min-h-[280px] u-hover-lift',
          ].join(' ')}
          aria-labelledby={`testimoni-name-${i}`}
        >
          <!-- Sample Tag (always visible, honesty R-18) -->
          <div class="w-fit shrink-0 flex flex-row gap-[6px] px-[10px] py-[6px] items-center bg-surface-muted rounded-[8px]">
            <!-- edit_note icon -->
            <svg
              viewBox="0 0 14.000015258789062 14"
              preserveAspectRatio="xMidYMid meet"
              xmlns="http://www.w3.org/2000/svg"
              class="w-[16px] shrink-0 h-[16px]"
              aria-hidden="true"
            >
              <path d={editNotePathD} fill="#6B7672"></path>
            </svg>
            <span class="text-[12px] leading-normal text-text-secondary font-semibold whitespace-nowrap">
              Contoh testimoni, ganti sebelum terbit
            </span>
          </div>

          <!-- Quote -->
          <blockquote class="w-full text-[18px] leading-[29px] text-ink-900 font-medium flex-1 flex items-center">
            <p>"{item.quote}"</p>
          </blockquote>

          <!-- Person -->
          <div class="w-full flex flex-row gap-[14px] items-center">
            <!-- Geometric avatar with initials — NO fake photo -->
            <div
              class={[
                'w-[44px] shrink-0 h-[44px] rounded-full flex items-center justify-center font-bold text-[15px] select-none',
                avatarBg[i % avatarBg.length],
              ].join(' ')}
              aria-hidden="true"
            >
              {initials(item.name)}
            </div>
            <!-- Info -->
            <div class="flex-1 flex flex-col gap-[2px]">
              <p
                id={`testimoni-name-${i}`}
                class="w-full text-[16px] leading-normal text-ink-900 font-semibold"
              >
                {item.name}
              </p>
              <p class="w-full text-[14px] leading-normal text-text-secondary font-normal">
                {item.role}
              </p>
            </div>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
