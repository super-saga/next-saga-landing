---
import Reveal from '../ui/Reveal.astro';
import { trust } from '../../data/content.id';

// Supporting cards from trust.points[1] and trust.points[2]
const supporting = trust.points.slice(1);
---

<!--
  Trust & Transparansi — pixel-match pen.dev ref (09-trust.html)
  ink dark surface, desktop-first. AA contrast guaranteed: all text on dark bg uses white/mint.
-->
<section id="trust" class="bg-[#0F1A17] w-full">
  <div class="box-border w-full flex flex-col gap-[56px] px-4 py-[80px] sm:px-8 lg:px-[120px] lg:py-[112px]">

    <!-- Header -->
    <Reveal>
      <div class="flex flex-col gap-[16px] w-full lg:w-[900px]">
        <!-- Eyebrow -->
        <p class="text-[13px] leading-normal font-bold tracking-[1.2px] text-[#5FD4AE] uppercase">
          TRANSPARANSI
        </p>
        <!-- Heading -->
        <h2 class="text-[28px] leading-[36px] lg:text-[40px] lg:leading-[48px] font-bold tracking-[-0.8px] text-white">
          {trust.heading}
        </h2>
        <!-- Subhead — not in content.id.ts model; sourced from reference spec -->
        <p class="text-[16px] leading-[26px] lg:text-[18px] lg:leading-[29px] font-normal text-[#E3E7E5]">
          Kepercayaan warga dimulai dari kejelasan alur uang. Ini cara Sahabat Warga menjaganya.
        </p>
      </div>
    </Reveal>

    <!-- Grid: Lead card + Supporting stack -->
    <Reveal delay={80}>
      <div class="flex flex-col lg:flex-row gap-[24px] w-full items-start">

        <!-- ── Lead card: Saldo Komunitas ── -->
        <div class="flex flex-col gap-[20px] p-[32px] lg:p-[48px] bg-[#C9F5E4] rounded-[32px] w-full lg:w-[588px] shrink-0">

          <!-- Top section -->
          <div class="flex flex-col gap-[20px]">
            <!-- Icon tile -->
            <div class="flex items-center justify-center w-[64px] h-[64px] bg-[#06372A] rounded-[18px] shrink-0">
              <!-- account_balance_wallet -->
              <svg viewBox="0 0 14 14" width="32" height="32" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                <path d="M2.91553 9.91553l0 0.81006q0 0.15723 0 0.25976 0 0.09912 0 0.09912 0 0 0-0.09912 0-0.10254 0-0.25976l0-7.45118q0-0.15723 0-0.25634 0-0.10254 0-0.10254 0 0 0 0.10254 0 0.09912 0 0.25634l0 0.81006q0 0 0 0.41358 0 0.41357 0 1.11084l0 2.78222q0 0.69727 0 1.11084 0 0.41357 0 0.41358z m0.35888 1.75q-0.38965 0-0.6665-0.27344-0.27344-0.27686-0.27344-0.6665l0-7.45118q0-0.38965 0.27344-0.66308 0.27686-0.27686 0.6665-0.27686l7.45118 0q0.38965 0 0.66308 0.27686 0.27686 0.27344 0.27686 0.66308l0 1.71924-0.58106 0 0-1.71924q0-0.15723-0.10254-0.25634-0.09912-0.10254-0.25634-0.10254l-7.45118 0q-0.15723 0-0.25976 0.10254-0.09912 0.09912-0.09912 0.25634l0 7.45118q0 0.15723 0.09912 0.25976 0.10254 0.09912 0.25976 0.09912l7.45118 0q0.15723 0 0.25634-0.09912 0.10254-0.10254 0.10254-0.25976l0-1.71924 0.58106 0 0 1.71924q0 0.38965-0.27686 0.6665-0.27344 0.27344-0.66308 0.27344l-7.45118 0z m4.66895-2.33106q-0.39307 0-0.66992-0.27343-0.27344-0.27686-0.27344-0.66993l0-2.78222q0-0.39307 0.27344-0.66651 0.27686-0.27686 0.66992-0.27685l3.36328 0q0.39307 0 0.66651 0.27685 0.27685 0.27344 0.27685 0.66651l0 2.78222q0 0.39307-0.27685 0.66993-0.27344 0.27344-0.66651 0.27343l-3.36328 0z m3.36328-0.58447q0.15723 0 0.25635-0.09912 0.10254-0.10254 0.10254-0.25977l0-2.78222q0-0.15723-0.10254-0.25635-0.09912-0.10254-0.25635-0.10254l-3.36328 0q-0.15723 0-0.25977 0.10254-0.09912 0.09912-0.09912 0.25635l0 2.78222q0 0.15723 0.09912 0.25977 0.10254 0.09912 0.25977 0.09912l3.36328 0z m-1.97217-0.875q0.3623 0 0.61866-0.25293 0.25635-0.25635 0.25634-0.62207 0-0.36572-0.25634-0.61865-0.25635-0.25635-0.61866-0.25635-0.36572 0-0.62207 0.25635-0.25293 0.25293-0.25293 0.61865 0 0.36572 0.25293 0.62207 0.25635 0.25293 0.62207 0.25293z" fill="#C9F5E4"/>
              </svg>
            </div>

            <!-- Title -->
            <h3 class="text-[24px] leading-[30px] lg:text-[32px] lg:leading-[38px] font-bold tracking-[-0.5px] text-[#06372A]">
              {trust.points[0].title}
            </h3>

            <!-- Body -->
            <p class="text-[16px] leading-[26px] lg:text-[18px] lg:leading-[29px] font-medium text-[#06372A]">
              Pembayaran warga terkumpul di saldo komunitas dan tercatat otomatis. Pengurus
              mencairkannya ke rekening kas, manual dengan persetujuan atau terjadwal otomatis.
            </p>
          </div>

          <!-- Flow: steps + payout modes, separated by mint top-border -->
          <div class="flex flex-col gap-[12px] pt-[20px] border-t border-[#5FD4AE]">

            <!-- Steps row -->
            <div class="flex flex-row flex-wrap gap-[8px] items-center">

              <!-- Warga bayar -->
              <div class="flex flex-row gap-[8px] px-[12px] py-[8px] bg-white rounded-[12px] items-center">
