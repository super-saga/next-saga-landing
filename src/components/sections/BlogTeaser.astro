---
import Reveal from '../ui/Reveal.astro';
import PostCard from '../blog/PostCard.astro';
import { getPosts } from '../../lib/ghost';

// Latest 3 posts for the landing teaser (SSR, fetched per request).
const posts = (await getPosts('all')).slice(0, 3);
---

{posts.length > 0 && (
  <section id="artikel" class="bg-bg">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-[120px] py-16 lg:py-[112px]">

      <!-- Header row -->
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between mb-10 lg:mb-14">
        <div class="flex flex-col gap-[16px] max-w-[640px]">
          <p class="text-[13px] font-bold tracking-[1.2px] uppercase text-text-brand">
            ARTIKEL
          </p>
          <h2 class="font-sans text-[28px] lg:text-[40px] font-bold leading-tight lg:leading-[48px] tracking-[-0.8px] text-ink-900">
            Tips & cerita kelola lingkungan
          </h2>
          <p class="font-sans text-[16px] lg:text-[18px] leading-[29px] text-text-secondary">
            Panduan praktis seputar iuran, keuangan RT/RW, dan membangun komunitas yang lebih tertib.
          </p>
        </div>
        <a
          href="/blog/"
          class="u-press inline-flex items-center gap-2 self-start rounded-full border border-border bg-surface px-5 py-3 font-sans text-[15px] font-semibold text-text-primary no-underline shrink-0"
        >
          Lihat semua artikel
          <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" aria-hidden="true">
            <path d="M7.5 5L12.5 10L7.5 15" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <!-- Cards -->
      <div class="u-stagger grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <Reveal>
            <PostCard post={post} />
          </Reveal>
        ))}
      </div>

    </div>
  </section>
)}
