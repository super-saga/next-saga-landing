---
interface Props {
  src: string;
  alt: string;
  width?: number;
  class?: string;
}

const {
  src,
  alt,
  width = 280,
  class: className,
} = Astro.props as Props;

const hasSrc = src && src.trim().length > 0;
const aspectHeight = Math.round(width * (16 / 9));
---

{hasSrc ? (
  <img
    src={src}
    alt={alt}
    width={width}
    loading="lazy"
    decoding="async"
    class={['block h-auto', className].filter(Boolean).join(' ')}
    style={`width:${width}px`}
  />
) : (
  <div
    class={[
      'relative overflow-hidden rounded-xl border border-border bg-surface-muted shadow-lg flex items-center justify-center text-text-primary text-sm font-sans',
      className,
    ].filter(Boolean).join(' ')}
    style={`width:${width}px;height:${aspectHeight}px`}
    aria-label={alt}
    role="img"
  >
    {alt}
  </div>
)}
