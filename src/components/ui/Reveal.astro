---
// Depends on the [data-reveal] transition defined in global.css.

interface Props {
  as?: string;
  class?: string;
  delay?: number;
}

const {
  as: tagRaw = 'div',
  class: className,
  delay,
} = Astro.props as Props;

const ALLOWED_TAGS = ['div', 'section', 'article', 'aside', 'header', 'footer', 'ul', 'ol', 'li', 'figure', 'span'] as const;
type AllowedTag = typeof ALLOWED_TAGS[number];

const Tag: AllowedTag = (ALLOWED_TAGS as readonly string[]).includes(tagRaw)
  ? (tagRaw as AllowedTag)
  : 'div';

const style = delay != null ? `transition-delay:${delay}ms` : undefined;
---

<Tag class={className} data-reveal style={style}>
  <slot />
</Tag>
