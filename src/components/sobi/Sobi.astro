---
// Static PNG mascot (the Rive animation looked off, so we use the illustration).
// Keeps the same props API (size, class, id) as before so all call sites are unchanged.
interface Props {
  size?: number;
  class?: string;
  id?: string;
}

const { size = 96, class: className = '', id } = Astro.props;
---

<img
  src="/mascots/sobi.png"
  alt="Sobi, asisten Sahabat Warga"
  class:list={['sobi-mascot object-contain', className]}
  style={`width:${size}px;height:${size}px;`}
  width={size}
  height={size}
  loading="eager"
  decoding="async"
  {id}
/>
