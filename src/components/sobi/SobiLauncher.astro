---
import Sobi from './Sobi.astro';
---

<div id="sobi-launcher-root" class="sobi-launcher-root fixed bottom-5 right-5 z-50 flex flex-col items-end gap-2" data-chat-open="false">
  <!-- Speech bubble (only shown for active states; hidden at idle so the pill stands alone) -->
  <div
    id="sobi-bubble"
    role="status"
    aria-live="polite"
    hidden
    class="sobi-bubble max-w-[180px] rounded-2xl rounded-br-sm bg-white px-3 py-2 text-sm font-medium text-gray-800 shadow-lg ring-1 ring-black/5 select-none"
  >
  </div>

  <!-- Launcher pill (shown when chat is CLOSED) -->
  <button
    type="button"
    id="sobi-launcher-btn"
    aria-label="Buka chat dengan Sobi"
    aria-expanded="false"
    class="sobi-launcher-btn group box-border flex h-[64px] w-fit flex-row items-center justify-start gap-[12px] rounded-[999px] bg-[#06372A] p-[8px_24px_8px_8px] [box-shadow:0px_16px_40px_#06372A40,_0px_2px_6px_#06372A26] transition-transform duration-200 hover:scale-[1.03] focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#5FD4AE] active:scale-[0.98]"
  >
    <!-- Avatar circle with mascot + online dot -->
    <span class="relative box-border flex h-[48px] w-[48px] shrink-0 items-center justify-center overflow-hidden rounded-[999px] bg-[#EEFBF5]">
      <Sobi size={48} id="sobi-mascot" />
      <span
        class="absolute left-[35px] top-[35px] box-border h-[13px] w-[13px] rounded-full bg-[#5FD4AE] [outline:2.5px_solid_#06372A] [z-index:2]"
        aria-hidden="true"
      ></span>
    </span>

    <!-- Text -->
    <span class="flex flex-col items-start">
      <span class="text-[16px] font-bold leading-normal text-white [white-space:nowrap]">Tanya Sobi</span>
      <span class="text-[12px] font-medium leading-normal text-[#5FD4AE] [white-space:nowrap]">Asisten 24 jam &middot; balas instan</span>
    </span>
  </button>

  <!-- Close FAB (shown when chat is OPEN) -->
  <button
    type="button"
    id="sobi-close-fab"
    aria-label="Tutup chat dengan Sobi"
    class="sobi-close-fab box-border hidden h-[56px] w-[56px] items-center justify-center rounded-full bg-[#06372A] text-white [box-shadow:0px_16px_40px_#06372A40,_0px_2px_6px_#06372A26] transition-transform duration-200 hover:scale-[1.05] focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#5FD4AE] active:scale-[0.97]"
  >
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" aria-hidden="true">
      <path d="M7 7L17 17M17 7L7 17" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
  </button>
</div>

<style>
  /* Toggle pill <-> close FAB based on chat open state */
  #sobi-launcher-root[data-chat-open="true"] .sobi-launcher-btn { display: none; }
  #sobi-launcher-root[data-chat-open="true"] .sobi-close-fab { display: flex; }
  #sobi-launcher-root[data-chat-open="false"] .sobi-close-fab { display: none; }
</style>

<script>
  import type { SobiState } from './sobi.ts';

  declare global {
    interface Window {
      __sobiSetLauncherOpen?: (open: boolean) => void;
    }
  }

  // Register speech bubble updater so sobi.ts can update DOM.
  const bubble = document.getElementById('sobi-bubble');
  if (bubble) {
    window.__sobiUpdateBubble = (text: string) => {
      // Idle message duplicates the pill subtitle, so hide the bubble at idle.
      if (!text || text === 'Siap membantu!') {
        bubble.hidden = true;
        bubble.textContent = '';
      } else {
        bubble.textContent = text;
        bubble.hidden = false;
      }
    };
  }

  // On first load: fire greet, then settle to idle.
  function greetOnce() {
    window.setSobiState?.('greeting' satisfies SobiState);
    setTimeout(() => {
      window.setSobiState?.('idle' satisfies SobiState);
    }, 2500);
  }

  // Greet after Rive inputs are registered (Rive emits no global event here,
  // so we wait for window load then give Rive ~300 ms to finish).
  let greetFired = false;
  function tryGreet() {
    if (greetFired) return;
    greetFired = true;
    greetOnce();
  }

  // Attempt greet once the page is interactive.
  if (document.readyState === 'complete') {
    setTimeout(tryGreet, 300);
  } else {
    window.addEventListener('load', () => setTimeout(tryGreet, 300), { once: true });
  }

  // Launcher pill click: open chat.
  const btn = document.getElementById('sobi-launcher-btn');
  if (btn) {
    btn.addEventListener('click', () => {
      window.openSobiChat?.();
    });
  }

  // Close FAB click: close chat.
  const closeFab = document.getElementById('sobi-close-fab');
  if (closeFab) {
    closeFab.addEventListener('click', () => {
      window.closeSobiChat?.();
    });
  }

  // Toggle launcher appearance when the chat opens/closes.
  // SobiChat calls window.__sobiSetLauncherOpen(true|false) from openPanel/closePanel.
  const root = document.getElementById('sobi-launcher-root');
  window.__sobiSetLauncherOpen = (open: boolean) => {
    if (!root) return;
    root.setAttribute('data-chat-open', open ? 'true' : 'false');
    btn?.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (open && bubble) bubble.hidden = true;
  };
</script>
