---
/**
 * SobiChat.astro — Floating AI chat panel for Sobi
 *
 * Opens via window.openSobiChat() / closes via window.closeSobiChat().
 * Streams tokens from /api/sobi/chat via SSE.
 * Drives Sobi Rive state: thinking -> speaking -> success|error -> idle.
 *
 * Accessibility:
 *   - role="dialog" + aria-modal + aria-label
 *   - Escape closes the panel
 *   - Focus moves to textarea on open; returns to launcher button on close
 *   - aria-live="polite" on the message list for incoming assistant text
 *   - Enter sends; Shift+Enter inserts newline
 */

import { WA_URL } from '../../config.ts';
import Sobi from './Sobi.astro';

// Popular questions
const popularQuestions = [
  {
    text: 'Berapa biaya langganannya?',
    icon: 'wallet',
  },
  {
    text: 'Cara daftarkan RT/RW saya',
    icon: 'house-plus',
  },
  {
    text: 'Warga bisa bayar pakai QRIS?',
    icon: 'qr-code',
  },
  {
    text: 'Apakah data kami aman?',
    icon: 'shield-check',
  },
];
---

<!-- Chat Panel -->
<div
  id="sobi-chat-panel"
  role="dialog"
  aria-modal="true"
  aria-label="Chat dengan Sobi"
  aria-hidden="true"
  class="fixed bottom-[84px] right-5 z-50 flex w-[380px] max-w-[calc(100vw-1.25rem)] flex-col rounded-[24px] overflow-hidden bg-white"
  style="display:none; box-shadow:0px 24px 60px #0F1A1733, 0px 2px 8px #0F1A171A; height: min(812px, calc(100dvh - 100px));"
>

  <!-- Panel Header -->
  <header
    class="flex w-full shrink-0 flex-row items-center gap-[12px] bg-[#06372A] px-[18px] py-[16px] pr-[16px]"
  >
    <!-- Avatar with online dot -->
    <div class="relative flex h-[40px] w-[40px] shrink-0 items-center justify-center overflow-hidden rounded-full">
      <div class="absolute inset-0 bg-[#EEFBF5]" style="z-index:0;"></div>
      <div class="absolute inset-0 overflow-hidden rounded-full" style="z-index:1;">
        <div
          class="absolute inset-0 bg-[url('/mascots/sobi-reference.png')] bg-no-repeat"
          style="background-size:178.6% 178.6%; background-position:-15.72px -8px;"
        ></div>
      </div>
      <div
        class="absolute rounded-full bg-[#5FD4AE]"
        style="width:11px;height:11px;left:29px;top:29px;outline:2px solid #06372A;z-index:2;"
      ></div>
    </div>

    <!-- Title block -->
    <div class="flex min-w-0 flex-1 flex-col gap-[2px]">
      <div class="flex flex-row items-center gap-[6px]">
        <span class="whitespace-nowrap text-[16px] font-bold leading-normal text-white">Sobi</span>
        <!-- AI badge -->
        <div class="flex shrink-0 items-center rounded-[6px] px-[6px] py-[2px]" style="background:rgba(201,245,228,0.15);">
          <span class="whitespace-nowrap text-[10px] font-bold tracking-[0.4px] text-[#C9F5E4]">AI</span>
        </div>
      </div>
      <span id="sobi-header-status" class="whitespace-nowrap text-[12px] font-medium leading-normal text-[#5FD4AE]">
        Asisten Sahabat Warga &middot; Online
      </span>
    </div>

    <!-- Minimize button (closes panel) -->
    <button
      id="sobi-chat-minimize"
      type="button"
      aria-label="Minimumkan chat"
      class="flex h-[32px] w-[32px] shrink-0 items-center justify-center rounded-full transition-colors hover:bg-white/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white"
      style="background:rgba(255,255,255,0.1);"
    >
      <!-- minus icon -->
      <svg width="16" height="16" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M2.731 6.453q-0.239 0.085-0.345 0.325-0.103 0.236-0.007 0.461 0.058 0.096 0.14 0.181 0.085 0.082 0.185 0.126l0.096 0.027 8.401 0 0.096-0.027q0.099-0.044 0.181-0.126 0.085-0.085 0.133-0.188 0.051-0.106 0.051-0.232 0-0.126-0.041-0.239-0.099-0.195-0.294-0.294l-0.085-0.041-4.228 0q-4.228 0-4.283 0.027z" fill="#FFFFFF"/>
      </svg>
    </button>

    <!-- Close button -->
    <button
      id="sobi-chat-close"
      type="button"
      aria-label="Tutup chat"
      class="flex h-[32px] w-[32px] shrink-0 items-center justify-center rounded-full transition-colors hover:bg-white/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white"
      style="background:rgba(255,255,255,0.1);"
    >
      <!-- x icon -->
      <svg width="16" height="16" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M3.346 2.939q-0.253 0.085-0.379 0.308-0.041 0.085-0.041 0.253 0 0.167 0.041 0.253 0.044 0.082 1.624 1.665l1.583 1.583-1.583 1.583q-1.579 1.583-1.624 1.668-0.041 0.082-0.041 0.236 0 0.154 0.034 0.239 0.038 0.082 0.133 0.181 0.099 0.096 0.181 0.133 0.085 0.034 0.239 0.034 0.154 0 0.236-0.041 0.085-0.044 1.668-1.624l1.583-1.583 1.583 1.583q1.583 1.579 1.665 1.624 0.085 0.041 0.239 0.041 0.154 0 0.236-0.034 0.085-0.038 0.181-0.133 0.099-0.099 0.133-0.181 0.038-0.085 0.038-0.239 0-0.154-0.044-0.236-0.041-0.085-1.620-1.668l-1.583-1.583 1.583-1.583q1.579-1.583 1.620-1.665 0.044-0.085 0.044-0.253 0-0.167-0.041-0.253-0.099-0.167-0.280-0.267-0.058-0.027-0.099-0.041-0.041-0.014-0.154-0.014-0.113 0-0.154 0.014-0.041 0.014-0.113 0.041-0.099 0.058-1.665 1.627l-1.569 1.565-2.827-2.813q-0.311-0.294-0.420-0.379-0.085-0.055-0.198-0.055l-0.027 0q-0.140 0-0.181 0.014z" fill="#FFFFFF"/>
      </svg>
    </button>
  </header>

  <!-- Welcome state (shown when no messages) -->
  <div
    id="sobi-welcome-panel"
    class="flex w-full flex-1 flex-col gap-[12px] overflow-y-auto bg-[#F6F7F6] p-[16px]"
  >
    <!-- Sobi Hero -->
    <div class="flex w-full shrink-0 flex-col items-center gap-[4px]">
      <Sobi size={80} />
      <p class="whitespace-nowrap text-[16px] font-bold leading-normal text-[#0F1A17]">Hai, saya Sobi!</p>
      <p class="whitespace-nowrap text-[11px] font-medium leading-normal text-[#98A29E]">
        Hari ini &middot; Biasanya membalas instan
      </p>
    </div>

    <!-- Greeting bubble -->
    <div class="flex w-full shrink-0 flex-row items-start gap-[8px] pr-[16px]">
      <!-- Small avatar -->
      <div class="relative flex h-[32px] w-[32px] shrink-0 items-center justify-center overflow-hidden rounded-full">
        <div class="absolute inset-0 bg-[#EEFBF5]" style="z-index:0;"></div>
        <div class="absolute inset-0 overflow-hidden rounded-full" style="z-index:1;">
          <div
            class="absolute inset-0 bg-[url('/mascots/sobi-reference.png')] bg-no-repeat"
            style="background-size:178.6% 178.6%; background-position:-12.576px -6.4px;"
          ></div>
        </div>
      </div>
      <!-- Bubble -->
      <div class="flex flex-1 flex-col gap-[10px] rounded-[6px_20px_20px_20px] bg-[#EEF1EF] p-[12px_14px]">
        <p class="text-[14px] font-normal leading-[21px] text-[#0F1A17]">
          Halo! Saya Sobi 👋 Saya bisa bantu jelaskan fitur, harga, dan cara mulai pakai
          Sahabat Warga untuk lingkungan Anda.
        </p>
      </div>
    </div>

    <!-- Popular Questions -->
    <div class="flex w-full shrink-0 flex-col gap-[8px] pl-[40px]">
      <p class="whitespace-nowrap text-[10px] font-bold tracking-[0.8px] text-[#98A29E]">PERTANYAAN POPULER</p>

