          <path d="M5.096 2.939q-0.253 0.085-0.379 0.308-0.041 0.085-0.041 0.253 0 0.167 0.041 0.253 0.044 0.082 1.624 1.665l1.583 1.583-1.583 1.583q-1.579 1.583-1.624 1.668-0.041 0.082-0.041 0.236 0 0.154 0.034 0.239 0.038 0.082 0.133 0.181 0.099 0.096 0.181 0.133 0.085 0.034 0.239 0.034 0.154 0 0.243-0.048 0.092-0.051 1.904-1.863 1.815-1.815 1.863-1.904 0.051-0.092 0.051-0.260 0-0.167-0.044-0.250-0.041-0.085-1.859-1.907l-1.442-1.429q-0.335-0.335-0.461-0.417-0.099-0.072-0.198-0.072l-0.041 0q-0.140 0-0.181 0.014z" fill="#98A29E"/>
        </svg>
      </button>

      <!-- Q2: Cara daftarkan RT/RW -->
      <button
        type="button"
        data-popular-question="Cara daftarkan RT/RW saya"
        class="flex w-full shrink-0 cursor-pointer flex-row items-center gap-[10px] rounded-[14px] bg-white px-[12px] py-[11px] text-left transition-colors hover:bg-[#EEFBF5] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0E9F76] group u-interactive"
        style="outline:1px solid #E3E7E5; outline-offset:-0.5px;"
      >
        <div class="flex h-[28px] w-[28px] shrink-0 items-center justify-center rounded-[8px] bg-[#EEFBF5]">
