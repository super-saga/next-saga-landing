          class="flex-1 resize-none border-0 bg-transparent text-[15px] font-normal leading-normal text-[#0F1A17] placeholder-[#98A29E] focus:outline-none"
          style="max-height:80px;overflow-y:auto;padding:0;"
        ></textarea>
        <button
          id="sobi-chat-send"
          type="submit"
          aria-label="Kirim pesan"
          class="flex h-[36px] w-[36px] shrink-0 items-center justify-center rounded-full bg-[#0E9F76] text-white transition-colors hover:bg-[#08745A] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0E9F76] disabled:cursor-not-allowed disabled:opacity-50"
        >
          <!-- arrow-up icon -->
          <svg width="18" height="18" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M6.846 2.352q-0.085 0.014-0.157 0.065-0.068 0.048-2.167 2.146l-1.665 1.695q-0.366 0.362-0.465 0.502-0.055 0.085-0.055 0.198l0 0.041q0 0.239 0.181 0.420 0.113 0.113 0.280 0.147 0.167 0.034 0.321-0.021 0.085-0.027 0.321-0.260 0.239-0.232 1.374-1.364 1.583-1.583 1.596-1.583 0.014 0 0.014 3.428l0 3.011q0 0.448 0.034 0.533 0.038 0.082 0.120 0.167 0.085 0.082 0.188 0.133 0.106 0.048 0.232 0.048 0.126 0 0.229-0.048 0.106-0.051 0.188-0.133 0.085-0.085 0.120-0.167 0.038-0.085 0.038-0.533l0-3.011q0-3.428 0.014-3.428 0.014 0 1.596 1.583 1.135 1.131 1.371 1.364 0.239 0.232 0.325 0.260 0.154 0.055 0.321 0.021 0.167-0.034 0.280-0.147 0.181-0.181 0.181-0.420l0-0.041q0-0.113-0.055-0.198-0.099-0.140-0.465-0.516l-1.678-1.682q-2.102-2.112-2.170-2.146-0.068-0.038-0.161-0.065-0.092-0.027-0.140-0.027-0.048 0-0.147 0.027z" fill="#FFFFFF"/>
          </svg>
        </button>
      </div>
    </form>

    <!-- Disclaimer -->
    <p class="text-[11px] font-normal leading-normal text-[#98A29E]">
      Sobi didukung AI dan bisa keliru. Info penting? Tanya tim kami.
    </p>
  </div>
</div>

<script>
  import type { SobiState } from './sobi.ts';

  // ---------------------------------------------------------------------------
  // Types
  // ---------------------------------------------------------------------------

  type ChatRole = 'user' | 'assistant' | 'system';
  type ChatMessage = { role: ChatRole; content: string };

  // ---------------------------------------------------------------------------
  // DOM refs
  // ---------------------------------------------------------------------------

  const panel = document.getElementById('sobi-chat-panel') as HTMLDivElement | null;
  const closeBtn = document.getElementById('sobi-chat-close') as HTMLButtonElement | null;
  const minimizeBtn = document.getElementById('sobi-chat-minimize') as HTMLButtonElement | null;
  const form = document.getElementById('sobi-chat-form') as HTMLFormElement | null;
  const input = document.getElementById('sobi-chat-input') as HTMLTextAreaElement | null;
  const sendBtn = document.getElementById('sobi-chat-send') as HTMLButtonElement | null;
  const messageList = document.getElementById('sobi-chat-messages') as HTMLDivElement | null;
  const welcomePanel = document.getElementById('sobi-welcome-panel') as HTMLDivElement | null;
  const srStatus = document.getElementById('sobi-sr-status') as HTMLParagraphElement | null;
  const headerStatus = document.getElementById('sobi-header-status') as HTMLSpanElement | null;

  if (!panel || !closeBtn || !form || !input || !sendBtn || !messageList) {
    console.warn('[SobiChat] Required DOM elements not found');
  }

  /**
   * Announce a completed assistant reply to screen readers via the single polite
   * live region. Called once per reply, never during token streaming.
   */
  function announceToSR(text: string): void {
    if (!srStatus) return;
    srStatus.textContent = '';
    requestAnimationFrame(() => {
      srStatus.textContent = text;
    });
  }

  // ---------------------------------------------------------------------------
  // State
  // ---------------------------------------------------------------------------

  let isOpen = false;
  let isBusy = false;
  let hasMessages = false;
  const history: ChatMessage[] = [];

  let _requestId = 0;

  // ---------------------------------------------------------------------------
  // Welcome / conversation panel switching
  // ---------------------------------------------------------------------------

  function showConversationPanel(): void {
    if (!welcomePanel || !messageList) return;
    if (hasMessages) return; // already switched
    hasMessages = true;
    welcomePanel.classList.add('hidden');
    messageList.classList.remove('hidden');
    messageList.classList.add('flex');
  }

  // ---------------------------------------------------------------------------
  // Panel open / close
  // ---------------------------------------------------------------------------

  function openPanel(): void {
    if (!panel) return;
    isOpen = true;
    panel.style.display = 'flex';
    panel.removeAttribute('aria-hidden');

    // Toggle the launcher into its "close" state.
    window.__sobiSetLauncherOpen?.(true);

    // Focus to textarea.
    requestAnimationFrame(() => input?.focus());

    // Drive Sobi mascot.
    window.setSobiState?.('greeting' satisfies SobiState);
    setTimeout(() => {
      if (isOpen && !isBusy) {
        window.setSobiState?.('idle' satisfies SobiState);
      }
    }, 2000);
  }

  function closePanel(): void {
    if (!panel) return;
    isOpen = false;
    panel.style.display = 'none';
    panel.setAttribute('aria-hidden', 'true');

    // Restore the launcher pill.
    window.__sobiSetLauncherOpen?.(false);

    // Return focus to launcher button.
    const launcher = document.getElementById('sobi-launcher-btn');
    launcher?.focus();

    // Settle mascot.
    window.setSobiState?.('idle' satisfies SobiState);
  }

  // Expose globally for SobiLauncher + sobi.ts.
  window.openSobiChat = openPanel;
  window.closeSobiChat = closePanel;

  // ---------------------------------------------------------------------------
  // Message rendering
  // ---------------------------------------------------------------------------

  function renderSobiAvatar(): HTMLDivElement {
    const avatar = document.createElement('div');
    avatar.className = 'relative flex h-[32px] w-[32px] shrink-0 items-center justify-center overflow-hidden rounded-full';
    avatar.innerHTML = `
      <div class="absolute inset-0 bg-[#EEFBF5]" style="z-index:0;"></div>
      <div class="absolute inset-0 overflow-hidden rounded-full" style="z-index:1;">
        <div class="absolute inset-0" style="background:url('/mascots/sobi-reference.png') no-repeat;background-size:178.6% 178.6%;background-position:-12.576px -6.4px;"></div>
      </div>
    `;
    return avatar;
  }

  function appendMessage(role: ChatRole, text: string): HTMLParagraphElement {
    if (!messageList) return document.createElement('p');

    // Switch to conversation view on first message
    showConversationPanel();

    const isUser = role === 'user';
    const wrapper = document.createElement('div');

    if (isUser) {
      wrapper.className = 'flex w-full shrink-0 flex-row justify-end items-start';
      const bubble = document.createElement('p');
      bubble.className = 'w-fit shrink-0 rounded-[20px_6px_20px_20px] bg-[#0E9F76] px-[14px] py-[12px] text-[14px] font-normal leading-[21px] text-white';
      bubble.style.maxWidth = '75%';
      bubble.textContent = text;
      wrapper.appendChild(bubble);
      messageList.appendChild(wrapper);
      messageList.scrollTop = messageList.scrollHeight;
      return bubble;
    } else {
      wrapper.className = 'flex w-full shrink-0 flex-row items-start gap-[8px] pr-[16px]';
      const avatar = renderSobiAvatar();
      const bubbleWrapper = document.createElement('div');
      bubbleWrapper.className = 'flex flex-1 flex-col gap-[10px] rounded-[6px_20px_20px_20px] bg-[#EEF1EF] px-[14px] py-[12px]';
      const bubble = document.createElement('p');
      bubble.className = 'w-full text-[14px] font-normal leading-[21px] text-[#0F1A17]';
      bubble.textContent = text;
      bubbleWrapper.appendChild(bubble);
      wrapper.appendChild(avatar);
      wrapper.appendChild(bubbleWrapper);
      messageList.appendChild(wrapper);
      messageList.scrollTop = messageList.scrollHeight;
      return bubble;
    }
  }

  function appendSourceChip(bubbleWrapper: Element, sourceText: string): void {
    const chip = document.createElement('div');
    chip.className = 'flex w-fit h-[28px] shrink-0 flex-row items-center gap-[6px] rounded-[8px] bg-white px-[10px]';
    chip.style.outline = '1px solid #E3E7E5';
    chip.style.outlineOffset = '-0.5px';
    chip.innerHTML = `
      <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M3.333 0.602q-0.588 0.041-1.022 0.448-0.434 0.407-0.533 0.995-0.027 0.167-0.027 4.956 0 4.789 0.027 4.956 0.099 0.533 0.468 0.926 0.373 0.390 0.906 0.502 0.109 0.014 0.670 0.027l3.179 0 3.179 0q0.561-0.014 0.670-0.027 0.533-0.113 0.902-0.502 0.373-0.393 0.472-0.926 0.027-0.167 0.027-3.801 0-3.633-0.027-3.801-0.085-0.520-0.407-0.923-0.113-0.140-1.248-1.275-0.896-0.882-1.107-1.070-0.209-0.191-0.417-0.291-0.308-0.154-0.673-0.195-0.140-0.027-2.492-0.027-2.352 0-2.546 0.027z m4.255 2.423l0 1.271 0.041 0.140q0.085 0.226 0.246 0.407 0.161 0.181 0.355 0.280 0.140 0.072 0.226 0.085 0.126 0.027 0.407 0.041l2.211 0 0 6.118q0 0.434-0.038 0.520-0.034 0.082-0.120 0.174-0.082 0.089-0.164 0.133l-0.099 0.041-7.308 0-0.099-0.041q-0.082-0.044-0.167-0.133-0.082-0.092-0.120-0.174-0.034-0.085-0.034-0.701l0-4.187 0-4.187q0-0.615 0.027-0.684 0.058-0.126 0.167-0.232 0.113-0.106 0.239-0.133 0.085-0.014 2.143-0.014l2.071 0 0.014 1.275z m2.211 0.014l1.036 1.036-2.085 0 0-1.036q0-1.036 0-1.049l1.049 1.049z m-5.318 1.665q-0.185 0.058-0.291 0.212-0.103 0.154-0.103 0.335 0 0.239 0.181 0.420 0.085 0.082 0.154 0.113 0.072 0.027 0.253 0.041 0.126 0 0.574 0 0.448 0 0.574 0 0.181-0.014 0.250-0.041 0.072-0.031 0.157-0.113 0.181-0.181 0.181-0.420 0-0.239-0.167-0.407-0.072-0.068-0.167-0.126l-0.085-0.041-0.728 0q-0.728 0-0.783 0.027z m0.041 2.311q-0.140 0.041-0.267 0.167-0.167 0.154-0.174 0.373-0.007 0.215 0.126 0.386 0.133 0.167 0.355 0.209 0.099 0.027 2.437 0.027 2.338 0 2.437-0.027 0.236-0.041 0.369-0.236 0.133-0.198 0.092-0.438-0.014-0.096-0.051-0.164-0.034-0.072-0.113-0.140-0.075-0.072-0.157-0.116l-0.099-0.041-2.437-0.014q-2.451 0-2.519 0.014z m0.055 2.324q-0.294 0.055-0.427 0.321-0.130 0.267-0.007 0.533 0.044 0.068 0.120 0.140 0.079 0.068 0.161 0.113l0.099 0.041 4.956 0 0.099-0.041q0.082-0.044 0.157-0.113 0.079-0.072 0.113-0.140 0.038-0.072 0.051-0.181 0.041-0.198-0.051-0.366-0.089-0.167-0.284-0.267l-0.099-0.041-2.410 0q-2.393 0-2.478 0z" fill="#6B7672"/>
      </svg>
      <span class="whitespace-nowrap text-[11px] font-semibold text-[#6B7672]">${sourceText}</span>
    `;
    bubbleWrapper.appendChild(chip);
  }

  function appendErrorMessage(text: string): void {
    if (!messageList) return;
    showConversationPanel();
    const wrapper = document.createElement('div');
    wrapper.className = 'flex justify-start';
    const bubble = document.createElement('p');
    bubble.className = 'rounded-[18px] rounded-bl-sm bg-red-50 px-[14px] py-[12px] text-[14px] text-red-700 ring-1 ring-red-200';
    bubble.style.maxWidth = '80%';
    bubble.textContent = text;
    wrapper.appendChild(bubble);
    messageList.appendChild(wrapper);
    messageList.scrollTop = messageList.scrollHeight;
  }

  // ---------------------------------------------------------------------------
  // SSE streaming send
  // ---------------------------------------------------------------------------

  async function sendMessage(text: string): Promise<void> {
    if (isBusy || !text.trim()) return;

    isBusy = true;
    if (sendBtn) sendBtn.disabled = true;
    if (headerStatus) headerStatus.textContent = 'Sobi sedang mengetik...';

    const myRequestId = ++_requestId;

    appendMessage('user', text);
    history.push({ role: 'user', content: text });

    window.setSobiState?.('thinking' satisfies SobiState);

    let assistantBubble: HTMLParagraphElement | null = null;
    let assistantBubbleWrapper: Element | null = null;
    let assistantText = '';

    try {
      const res = await fetch('/api/sobi/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: history }),
      });

      if (!res.ok || !res.body) {
        await res.text().catch(() => {});
        throw new Error(`HTTP ${res.status}`);
      }

      const reader = res.body.getReader();
      const decoder = new TextDecoder();
      let buffer = '';
      let firstToken = true;

      while (true) {
        const { value, done } = await reader.read();
        if (done) break;

        buffer += decoder.decode(value, { stream: true });

        const events = buffer.split('\n\n');
        buffer = events.pop() ?? '';

        for (const event of events) {
          const line = event.trim();
          if (!line.startsWith('data:')) continue;
          const data = line.slice(5).trim();

          if (data === '[DONE]') {
            if (assistantText) {
              history.push({ role: 'assistant', content: assistantText });
              announceToSR(assistantText);
              // Add source chip to the bubble wrapper
              if (assistantBubbleWrapper) {
                appendSourceChip(assistantBubbleWrapper, 'sahabatwarga.id');
              }
            }
            window.setSobiState?.('success' satisfies SobiState);
            setTimeout(() => {
              if (myRequestId === _requestId) {
                window.setSobiState?.('idle' satisfies SobiState);
              }
            }, 1500);
            continue;
          }

          let parsed: { token?: string };
          try {
            parsed = JSON.parse(data);
          } catch {
            continue;
          }

          const token = parsed.token ?? '';
          if (!token) continue;

          if (firstToken) {
            firstToken = false;
            window.setSobiState?.('speaking' satisfies SobiState);

            // Build assistant bubble structure
            showConversationPanel();
            const wrapper = document.createElement('div');
            wrapper.className = 'flex w-full shrink-0 flex-row items-start gap-[8px] pr-[16px]';
            const avatar = renderSobiAvatar();
            const bw = document.createElement('div');
            bw.className = 'flex flex-1 flex-col gap-[10px] rounded-[6px_20px_20px_20px] bg-[#EEF1EF] px-[14px] py-[12px]';
            const bubble = document.createElement('p');
            bubble.className = 'w-full text-[14px] font-normal leading-[21px] text-[#0F1A17]';
            bw.appendChild(bubble);
            wrapper.appendChild(avatar);
            wrapper.appendChild(bw);
            messageList?.appendChild(wrapper);
            assistantBubble = bubble;
            assistantBubbleWrapper = bw;
          }

          assistantText += token;
          if (assistantBubble) {
            // textContent only — no innerHTML, no XSS
            assistantBubble.textContent = assistantText;
            messageList?.scrollTo({ top: messageList.scrollHeight, behavior: 'smooth' });
          }
        }
      }
    } catch (err) {
      console.error('[SobiChat] stream error:', err);
      window.setSobiState?.('error' satisfies SobiState);
      appendErrorMessage('Maaf, terjadi kesalahan. Silakan coba lagi.');
      setTimeout(() => {
        if (myRequestId === _requestId) {
          window.setSobiState?.('idle' satisfies SobiState);
        }
      }, 2000);
    } finally {
      isBusy = false;
      if (sendBtn) sendBtn.disabled = false;
      if (headerStatus) headerStatus.textContent = 'Asisten Sahabat Warga · Online';
      input?.focus();
    }
  }

  // ---------------------------------------------------------------------------
  // Event listeners
  // ---------------------------------------------------------------------------

  closeBtn?.addEventListener('click', closePanel);
  minimizeBtn?.addEventListener('click', closePanel);

  // Escape key closes panel.
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape' && isOpen) {
      closePanel();
    }
  });

  // Form submit.
  form?.addEventListener('submit', (e: Event) => {
    e.preventDefault();
    const text = input?.value ?? '';
    if (!text.trim()) return;
    if (input) input.value = '';
    autoResizeTextarea();
    void sendMessage(text);
  });

  // Popular question buttons.
  document.querySelectorAll<HTMLButtonElement>('[data-popular-question]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const question = btn.dataset.popularQuestion ?? '';
      if (!question) return;
      // Populate and trigger send
      if (input) input.value = question;
      autoResizeTextarea();
      void sendMessage(question);
      if (input) input.value = '';
      autoResizeTextarea();
    });
  });

  // Textarea: Enter sends, Shift+Enter newline; auto-resize.
  function autoResizeTextarea(): void {
    if (!input) return;
    input.style.height = 'auto';
    input.style.height = `${Math.min(input.scrollHeight, 80)}px`;
  }

  input?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      const text = input.value;
      if (!text.trim()) return;
      input.value = '';
      autoResizeTextarea();
      void sendMessage(text);
    }
  });

  input?.addEventListener('input', autoResizeTextarea);

  // Focus trap: Tab should stay within the panel while it is open.
  panel?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key !== 'Tab' || !isOpen) return;
    const focusable = panel.querySelectorAll<HTMLElement>(
      'button:not([disabled]), textarea:not([disabled]), a[href], [tabindex]:not([tabindex="-1"])',
    );
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (!first || !last) return;

    if (e.shiftKey) {
      if (document.activeElement === first) {
        e.preventDefault();
        last.focus();
      }
    } else {
      if (document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });
</script>
