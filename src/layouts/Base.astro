---
import '../styles/global.css';
import { SITE, ADSENSE_CLIENT } from '../config';
import SobiLauncher from '../components/sobi/SobiLauncher.astro';
import SobiChat from '../components/sobi/SobiChat.astro';
import WaitlistDialog from '../components/waitlist/WaitlistDialog.astro';
import SubscribeDialog from '../components/blog/SubscribeDialog.astro';
import ConsentBanner from '../components/ConsentBanner.astro';

interface Props {
  title: string;
  description: string;
  /** Override the canonical URL (e.g. blog pages use the trailing-slash form to match Ghost). */
  canonical?: string;
  /** Optional extra JSON-LD (e.g. Article schema on blog posts), injected as-is. */
  jsonLdExtra?: unknown;
  /** When true, emit a Twitter/X Player Card so the demo video plays inline on X. */
  playerCard?: boolean;
}

const { title, description, canonical, jsonLdExtra, playerCard = false } = Astro.props;

const canonicalUrl =
  canonical ?? new URL(Astro.url.pathname, Astro.site ?? SITE).toString();
const ogImage = new URL('/og/social-preview.png', Astro.site ?? SITE).toString();
const ogVideo = new URL('/social/sahabat-warga-demo.mp4', Astro.site ?? SITE).toString();
// Iframe player for the Twitter/X Player Card (X can't embed a raw mp4).
const twitterPlayer = new URL('/social/player.html', Astro.site ?? SITE).toString();
const ogImageAlt =
  'Tampilan aplikasi Sahabat Warga untuk mengelola lingkungan bersama';

// og:video breaks the link preview on platforms that DON'T render inline video
// (WhatsApp, Threads, LinkedIn): they try to treat the link as a video and show
// a broken/empty card instead of falling back to og:image. So we only advertise
// og:video to crawlers that reliably render it inline (Telegram, Discord). The
// page is SSR + uncached, so branching on User-Agent is safe. Everyone else gets
// the clean og:image preview.
const ua = Astro.request.headers.get('user-agent') ?? '';
const ogVideoCapable = /TelegramBot|Discordbot|Slackbot-LinkExpanding/i.test(ua);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: 'Sahabat Warga',
      url: SITE,
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Sahabat Warga',
      applicationCategory: 'LifestyleApplication',
      operatingSystem: 'Android, iOS',
    },
  ],
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Blog Sahabat Warga" href="/blog/rss.xml" />
    {ADSENSE_CLIENT && (
      <>
        {/* Consent Mode v2: default to denied until the visitor chooses, so ads
            stay non-personalized. Must run BEFORE the AdSense script. */}
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          window.gtag = window.gtag || gtag;
          var __swConsent = null;
          try { __swConsent = localStorage.getItem('sw_consent'); } catch (e) {}
          var __swGranted = __swConsent === 'granted';
          gtag('consent', 'default', {
            ad_storage: __swGranted ? 'granted' : 'denied',
            ad_user_data: __swGranted ? 'granted' : 'denied',
            ad_personalization: __swGranted ? 'granted' : 'denied',
            analytics_storage: __swGranted ? 'granted' : 'denied',
            wait_for_update: 500,
          });
        </script>
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
          crossorigin="anonymous"
        ></script>
      </>
    )}

    <!-- Favicon (Sahabat Warga brand mark) -->
    <link rel="icon" type="image/png" href="/brand/icon.png" />
    <link rel="apple-touch-icon" href="/brand/icon.png" />

    <!-- Theme color -->
    <meta name="theme-color" content="#0E9F76" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sahabat Warga" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {ogVideoCapable && (
      <>
        <meta property="og:video" content={ogVideo} />
        <meta property="og:video:secure_url" content={ogVideo} />
        <meta property="og:video:type" content="video/mp4" />
        <meta property="og:video:width" content="1280" />
        <meta property="og:video:height" content="720" />
      </>
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content={playerCard ? 'player' : 'summary_large_image'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {playerCard && (
      <>
        <meta name="twitter:player" content={twitterPlayer} />
        <meta name="twitter:player:width" content="1280" />
        <meta name="twitter:player:height" content="720" />
        <meta name="twitter:player:stream" content={ogVideo} />
        <meta name="twitter:player:stream:content_type" content="video/mp4" />
      </>
    )}

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {jsonLdExtra && <script type="application/ld+json" set:html={JSON.stringify(jsonLdExtra)} />}
  </head>
  <body>
    <slot />

    <WaitlistDialog />
    <SubscribeDialog />
    <SobiChat />
    <SobiLauncher />
    <ConsentBanner />

    <script>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        );
        const mount = () =>
          document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
        if (document.readyState !== 'loading') {
          mount();
        } else {
          document.addEventListener('DOMContentLoaded', mount);
        }
      } else {
        document.querySelectorAll('[data-reveal]').forEach((el) =>
          el.classList.add('is-visible'),
        );
      }
    </script>
  </body>
</html>
