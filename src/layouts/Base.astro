---
import '../styles/global.css';
import { SITE, ADSENSE_CLIENT } from '../config';
import SobiLauncher from '../components/sobi/SobiLauncher.astro';
import SobiChat from '../components/sobi/SobiChat.astro';
import WaitlistDialog from '../components/waitlist/WaitlistDialog.astro';
import SubscribeDialog from '../components/blog/SubscribeDialog.astro';

interface Props {
  title: string;
  description: string;
  /** Override the canonical URL (e.g. blog pages use the trailing-slash form to match Ghost). */
  canonical?: string;
  /** Optional extra JSON-LD (e.g. Article schema on blog posts), injected as-is. */
  jsonLdExtra?: unknown;
}

const { title, description, canonical, jsonLdExtra } = Astro.props;

const canonicalUrl =
  canonical ?? new URL(Astro.url.pathname, Astro.site ?? SITE).toString();
// Using og.svg as a non-404 placeholder. Pre-publish step: export a 1200x630 PNG/JPG
// (e.g. via Inkscape CLI or a design tool) and replace this with /og/og.png — some
// social crawlers (Facebook, LinkedIn) do not render SVG OG images.
const ogImage = new URL('/og/og.svg', Astro.site ?? SITE).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: 'Sahabat Warga',
      url: SITE,
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Sahabat Warga',
      applicationCategory: 'LifestyleApplication',
      operatingSystem: 'Android, iOS',
    },
  ],
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Blog Sahabat Warga" href="/blog/rss.xml" />
    {ADSENSE_CLIENT && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
        crossorigin="anonymous"
      ></script>
    )}

    <!-- Favicon (Sahabat Warga brand mark) -->
    <link rel="icon" type="image/png" href="/brand/icon.png" />
    <link rel="apple-touch-icon" href="/brand/icon.png" />

    <!-- Theme color -->
    <meta name="theme-color" content="#0E9F76" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {jsonLdExtra && <script type="application/ld+json" set:html={JSON.stringify(jsonLdExtra)} />}
  </head>
  <body>
    <slot />

    <WaitlistDialog />
    <SubscribeDialog />
    <SobiChat />
    <SobiLauncher />

    <script>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        );
        const mount = () =>
          document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
        if (document.readyState !== 'loading') {
          mount();
        } else {
          document.addEventListener('DOMContentLoaded', mount);
        }
      } else {
        document.querySelectorAll('[data-reveal]').forEach((el) =>
          el.classList.add('is-visible'),
        );
      }
    </script>
  </body>
</html>
